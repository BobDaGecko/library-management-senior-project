package pages

import (
	"fmt"
	"time"
	"voxelprismatic/library-management-senior-project/db"
	"voxelprismatic/library-management-senior-project/router/fail"
	"voxelprismatic/library-management-senior-project/web/common"
)

func getOverdueLoans() []db.Loan {
	var loans []db.Loan
	db.Db().
		Where("date_returned = ?", db.NilTime).
		Where("date_checkout < ?", time.Now().Add(-db.LOAN_DURATION)).
		Preload("User").
		Preload("BookCopy.BookWork").
		Order("date_checkout asc").
		Find(&loans)
	return loans
}

// buildWaiveConfirm creates the dynamic confirmation prompt including book title, loan ID, and user name.
func buildWaiveConfirm(l db.Loan) string {
	title := l.BookCopy.BookWork.Title
	if title == "" {
		title = "[Unknown Title]"
	}
	loanID := l.ID.String()
	userName := l.User.FirstName + " " + l.User.LastName
	return fmt.Sprintf("Waive fee for \"%s\" (Loan ID: %s) for %s? This cannot be undone.", title, loanID, userName)
}

// isFeeWaived checks if there is a fine for the loan and it has been waived.
func isFeeWaived(loanID db.SqlUUID) bool {
	var fine db.Fine
	err := db.Db().Where("loan_id = ?", loanID).First(&fine).Error
	if err != nil {
		return false // no fine or error -> treat as not waived (or button can still attempt)
	}
	return fine.AmountWaived > 0 || fine.WaivedReason != ""
}

// MgmtOverdue full page
templ MgmtOverdue(p *fail.RoutingParams) {
	@common.Head("Overdue Books - Management", "Overdue Books")
	@common.NavHead("Management", p.Param("q"))
	@common.NavAside(managementAsideLinks, p.Req.URL.Path)
	<main class="ml-80 mt-8">
		<div class="container-lg">
			<h1>Overdue Books</h1>
			<p class="mb-4">List of currently overdue loans. Librarians can waive associated fees using the button (with confirmation). Button is disabled if fee already waived.</p>
			<div id="overdue-container">
				@MgmtOverdueTable()
			</div>
		</div>
		@common.Footer()
	</main>
}

// MgmtOverdueTable renders the table of overdue loans and waive buttons.
templ MgmtOverdueTable() {
	<div id="overdue-table">
		<table class="table">
			<thead>
				<tr>
					<th>Book Title</th>
					<th>User</th>
					<th>Checked Out</th>
					<th>Days Overdue</th>
					<th>Loan ID</th>
					<th>Action</th>
				</tr>
			</thead>
			<tbody>
				for _, l := range getOverdueLoans() {
					@overdueRow(l)
				}
			</tbody>
		</table>
	</div>
}

templ overdueRow(l db.Loan) {
	<tr>
		<td>{ l.BookCopy.BookWork.Title }</td>
		<td>{ l.User.FirstName } { l.User.LastName }</td>
		<td>{ l.DateCheckout.Format("2006-01-02") }</td>
		<td>{ int(time.Since(l.DateCheckout).Hours() / 24) - int(db.LOAN_DURATION.Hours()/24) }</td>
		<td>{ l.ID.String() }</td>
		<td>
			if isFeeWaived(l.ID) {
				<button disabled>Waived</button>
			} else {
				<button
					hx-post="/management/overdue"
					hx-vals={ fmt.Sprintf(`{"loan_id":"%s","action":"waive"}`, l.ID.String()) }
					hx-confirm={ buildWaiveConfirm(l) }
					hx-target="this"
					hx-swap="outerHTML"
				>Waive Fee</button>
			}
		</td>
	</tr>
}

// WaiveButtonDisabled is returned after successful waive to replace the active button.
templ WaiveButtonDisabled() {
	<button disabled>Waived</button>
}