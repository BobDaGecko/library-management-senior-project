package pages

import (
	"fmt"
	"time"
	"voxelprismatic/library-management-senior-project/db"
	"voxelprismatic/library-management-senior-project/router/fail"
	"voxelprismatic/library-management-senior-project/web/common"
)

func getOverdueLoans() []db.Loan {
	var loans []db.Loan
	db.Db().
		Where("date_returned = ?", db.NilTime).
		Where("date_checkout < ?", time.Now().Add(-db.LOAN_DURATION)).
		Preload("User").
		Preload("BookCopy.BookWork").
		Order("date_checkout asc").
		Find(&loans)
	return loans
}

// buildWaiveConfirm creates the dynamic confirmation prompt including book title, loan ID, and user name.
func buildWaiveConfirm(l db.Loan) string {
	title := l.BookCopy.BookWork.Title
	if title == "" {
		title = "[Unknown Title]"
	}
	loanID := l.ID.String()
	userName := l.User.FirstName + " " + l.User.LastName
	return fmt.Sprintf("Waive fee for \"%s\" (Loan ID: %s) for %s? This cannot be undone.", title, loanID, userName)
}

// waivedLoanIDs returns the set of loans (from the given list) that already
// have a waived fine — one query for the whole table instead of one per row.
func waivedLoanIDs(loans []db.Loan) map[db.SqlUUID]bool {
	ret := map[db.SqlUUID]bool{}
	if len(loans) == 0 {
		return ret
	}
	ids := make([]db.SqlUUID, len(loans))
	for i, l := range loans {
		ids[i] = l.ID
	}
	var fines []db.Fine
	db.Db().Where("loan_id IN ?", ids).
		Where("amount_waived > 0 OR waived_reason != ''").
		Find(&fines)
	for _, f := range fines {
		ret[f.LoanID] = true
	}
	return ret
}

// MgmtOverdue full page
templ MgmtOverdue(p *fail.RoutingParams) {
	@common.Head("Overdue Books — Management", "Overdue Books")
	@common.MgmtNavHead(p.Req.URL.Path)
	<main class="page-main">
		<div class="container">
			<h1 class="mb-2">Overdue Books</h1>
			<p class="text-sub mb-6">Currently overdue loans. Waive fees with confirmation — disabled once waived.</p>
			<div id="overdue-container">
				@MgmtOverdueTable()
			</div>
		</div>
	</main>
	@common.Footer()
}

// MgmtOverdueTable renders the table of overdue loans and waive buttons.
templ MgmtOverdueTable() {
	{{ loans := getOverdueLoans() }}
	if len(loans) == 0 {
		<div id="overdue-table">
			<div class="card-flat">
				<div class="empty-state">
					<i class="material-icons empty-state-icon">schedule</i>
					<p class="empty-state-text">No overdue loans.</p>
				</div>
			</div>
		</div>
	} else {
		<div id="overdue-table">
			<table class="table">
				<thead>
					<tr>
						<th>Book Title</th>
						<th>User</th>
						<th>Checked Out</th>
						<th>Days Overdue</th>
						<th>Loan ID</th>
						<th>Action</th>
					</tr>
				</thead>
				<tbody>
					{{ waived := waivedLoanIDs(loans) }}
					for _, l := range loans {
						@overdueRow(l, waived[l.ID])
					}
				</tbody>
			</table>
		</div>
	}
}

templ overdueRow(l db.Loan, waived bool) {
	<tr>
		<td>@BookTitle(l.BookCopy.BookWork.Title)</td>
		<td>
			<a href={ templ.SafeURL("/management/users/" + l.User.ID.String()) }>
				{ l.User.FirstName } { l.User.LastName }
			</a>
		</td>
		<td>{ l.DateCheckout.Format("2006-01-02") }</td>
		<td>{ int(time.Since(l.DateCheckout).Hours() / 24) - int(db.LOAN_DURATION.Hours()/24) }</td>
		<td>{ l.ID.String() }</td>
		<td>
			if waived {
				<button class="btn btn-sm btn-subtle" disabled>Waived</button>
			} else {
				<button
					class="btn btn-sm btn-subtle"
					hx-post="/management/overdue"
					hx-vals={ fmt.Sprintf(`{"loan_id":"%s","action":"waive"}`, l.ID.String()) }
					hx-confirm={ buildWaiveConfirm(l) }
					hx-target="this"
					hx-swap="outerHTML"
				>Waive Fee</button>
			}
		</td>
	</tr>
}

// WaiveButtonDisabled is returned after successful waive to replace the active button.
templ WaiveButtonDisabled() {
	<button class="btn btn-sm btn-subtle" disabled>Waived</button>
}