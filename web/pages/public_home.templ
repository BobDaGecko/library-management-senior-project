package pages

import (
	"strings"
	"voxelprismatic/library-management-senior-project/db"
	"voxelprismatic/library-management-senior-project/router/fail"
	"voxelprismatic/library-management-senior-project/web/common"
)

// staffPickTagColor maps a tag string to a ctag variant for visual variety.
func staffPickTagColor(tag string) string {
	tag = strings.ToLower(strings.TrimSpace(tag))
	switch {
	case strings.Contains(tag, "staff") || strings.Contains(tag, "pick"):
		return "ctag-teal"
	case strings.Contains(tag, "new") || strings.Contains(tag, "arriv"):
		return "ctag-green"
	case strings.Contains(tag, "fiction"):
		return "ctag-sky"
	case strings.Contains(tag, "communit") || strings.Contains(tag, "event"):
		return "ctag-peach"
	default:
		return "ctag-muted"
	}
}

// PublicHomePage renders the public-facing homepage.
// staffPickBooks = up to 3 newest BookWork records shown as Staff Picks
// recentBooks = up to 6 most-recently-added BookWork records
templ PublicHomePage(p *fail.RoutingParams, staffPickBooks []db.BookWork, recentBooks []db.BookWork) {
	@common.Head("Town Library", "Discover books, audiobooks, and digital resources at your community library.")
	@common.NavHead(p.User, p.Req.URL.Path, "")
	<main class="page-main">
		<div class="container">
			<!-- ── Hero ─────────────────────────────────────────── -->
			<section class="home-hero">
				<div class="home-hero-inner">
					<h1 class="home-hero-heading">Discover Your Next Great Read</h1>
					<p class="home-hero-tagline">
						Search our catalog of books, audiobooks, and digital resources.
						Open to everyone in the community — free, always.
					</p>
					<form action="/search" method="get" class="home-hero-search" role="search">
						<div class="input-search home-hero-input-wrap">
							<input
								type="search"
								name="q"
								class="form-input home-hero-input"
								placeholder="Title, author, keyword…"
								aria-label="Search the library catalog"
								autofocus
							/>
							<button class="btn btn-primary input-icon" type="submit">
								<i class="material-icons">search</i>
							</button>
						</div>
					</form>
					<div class="home-hero-links">
						<a href="/blog/3" class="home-hero-link">Latest post</a>
						<span class="home-hero-link-sep">·</span>
						<a href="/blog" class="home-hero-link">Staff picks &amp; blog</a>
						<span class="home-hero-link-sep">·</span>
						<a href="/help" class="home-hero-link">How to borrow</a>
					</div>
				</div>
			</section>

			<!-- ── Staff Picks ───────────────────────────────────── -->
			if len(staffPickBooks) > 0 {
				<section class="home-section">
					<div class="home-section-header">
						<h2 class="home-section-title">Staff Picks</h2>
					</div>
					<div class="home-picks-grid">
						for _, b := range staffPickBooks {
							<article class="home-pick-card home-pick-card-book">
								<a href={ templ.SafeURL("/book/" + b.ID) } class="home-pick-cover-link">
									if b.CoverThumb != "" {
										<img src={ b.CoverThumb } alt={ b.Title } class="home-pick-book-cover"/>
									} else {
										<div class="home-pick-book-cover home-pick-book-cover-placeholder">
											<i class="material-icons">menu_book</i>
										</div>
									}
								</a>
								<div class="home-pick-body">
									<h3 class="home-pick-title">
										<a href={ templ.SafeURL("/book/" + b.ID) }>{ b.Title }</a>
									</h3>
									if len(b.Authors) > 0 {
										<p class="home-pick-author">by { strings.Join([]string(b.Authors), ", ") }</p>
									}
									if b.Description != "" {
										<p class="home-pick-teaser">{ truncateBody(stripHTMLHome(b.Description), 120) }</p>
									}
									<a href={ templ.SafeURL("/book/" + b.ID) } class="home-pick-readmore">View details →</a>
								</div>
							</article>
						}
					</div>
				</section>
			}

			<!-- ── Featured Post ─────────────────────────────────── -->
			<section class="home-section">
				{{ fp := blogPosts[2] }}
				<div class="home-featured-post card-flat">
					<div class="home-featured-post-eyebrow">
						<i class="material-icons" style="font-size:14px;">article</i>
						Featured Post
					</div>
					<h2 class="home-featured-post-title">
						<a href={ templ.SafeURL("/blog/" + fp.ID) }>{ fp.Title }</a>
					</h2>
					<div class="home-featured-post-tags">
						for _, tag := range fp.Tags {
							<span class={ "ctag " + staffPickTagColor(tag) }>{ tag }</span>
						}
					</div>
					if len(fp.Body) > 0 {
						<p class="home-featured-post-preview">{ truncateBody(fp.Body[0], 220) }</p>
					}
					<a href={ templ.SafeURL("/blog/" + fp.ID) } class="btn btn-subtle btn-sm">
						<i class="material-icons" style="font-size:14px;vertical-align:-2px;">open_in_new</i>
						Read More
					</a>
				</div>
			</section>

			<!-- ── Recently Added ────────────────────────────────── -->
			if len(recentBooks) > 0 {
				<section class="home-section">
					<div class="home-section-header">
						<h2 class="home-section-title">Recently Added</h2>
					</div>
					<div class="home-recent-grid">
						for _, b := range recentBooks {
							<a href={ templ.SafeURL("/book/" + b.ID) } class="book-cover-card">
								if b.CoverThumb != "" {
									<img src={ b.CoverThumb } alt={ b.Title } class="book-cover-card-img"/>
								} else {
									<div class="book-cover-card-img book-cover-card-placeholder">
										<i class="material-icons">menu_book</i>
									</div>
								}
								<div class="book-cover-card-info">
									<div class="book-cover-card-title">{ b.Title }</div>
									if len(b.Authors) > 0 {
										<div class="book-cover-card-author">{ strings.Join([]string(b.Authors), ", ") }</div>
									}
								</div>
							</a>
						}
					</div>
					<div class="mt-6" style="text-align:center">
						<a href="/search" class="btn btn-primary">
							<i class="material-icons" style="font-size:16px;vertical-align:-3px;">library_books</i>
							View Catalog
						</a>
					</div>
				</section>
			}
		</div>
	</main>
	@common.Footer()
}

// staffPickNumber returns "01", "02", "03" for the pick index.
func staffPickNumber(i int) string {
	switch i {
	case 0:
		return "01"
	case 1:
		return "02"
	default:
		return "03"
	}
}

// truncateBody trims body text to max characters at a word boundary.
func truncateBody(s string, max int) string {
	if len(s) <= max {
		return s
	}
	// trim to max then walk back to a space
	s = s[:max]
	for i := len(s) - 1; i >= 0; i-- {
		if s[i] == ' ' {
			return s[:i] + "…"
		}
	}
	return s + "…"
}

// stripHTMLHome removes HTML tags from a string for the homepage snippet.
func stripHTMLHome(s string) string {
	out := strings.Builder{}
	inTag := false
	for _, r := range s {
		switch {
		case r == '<':
			inTag = true
		case r == '>':
			inTag = false
		case !inTag:
			out.WriteRune(r)
		}
	}
	return out.String()
}
