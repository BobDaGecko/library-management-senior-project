package pages

import (
	"fmt"
	"time"

	"voxelprismatic/library-management-senior-project/db"
	"voxelprismatic/library-management-senior-project/router/fail"
	"voxelprismatic/library-management-senior-project/web/common"
)

// PatronHoldView is a flat hold row for patron-facing pages.
// It uses plain strings to avoid SqlUUID scan failures on Google Books IDs.
type PatronHoldView struct {
	HoldID        string
	BookWorkRawID string
	BookTitle     string
	Format        db.BookFmtFlag
	RequestedDate time.Time
}

templ HoldsPage(p *fail.RoutingParams, holds []PatronHoldView, isPostponed bool) {
	@common.Head("My Holds · Town Library", "View and manage your requested items.")
	@common.NavHead(p.User, p.Req.URL.Path, "")
	<main class="page-main">
		<div class="container">
			<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:var(--space-6)">
				<div>
					<h1>My Holds</h1>
					<p class="text-sub">{ fmt.Sprintf("%d active hold", len(holds)) }{ pluralS(len(holds)) }</p>
				</div>
				<a href="/user" class="btn btn-subtle">← Back to Account</a>
			</div>
			if len(holds) == 0 {
				<div class="empty-state">
					<div class="empty-state-icon"><i class="material-icons">schedule</i></div>
					<p class="empty-state-text">You have no active holds.</p>
				</div>
			} else {
				<table class="table">
					<thead>
						<tr>
							<th>Title</th>
							<th>Format</th>
							<th>Requested</th>
							<th>Status</th>
							<th></th>
						</tr>
					</thead>
					<tbody>
						for _, hold := range holds {
							<tr>
								<td>
									if hold.BookTitle != "" {
										<a href={ templ.SafeURL("/book/" + hold.BookWorkRawID) }>{ hold.BookTitle }</a>
									} else {
										<a href={ templ.SafeURL("/book/" + hold.BookWorkRawID) }>{ hold.BookWorkRawID }</a>
									}
								</td>
								<td><span class="ctag ctag-muted">{ hold.Format.DisplayName() }</span></td>
								<td>{ hold.RequestedDate.Format("Jan 2, 2006") }</td>
								<td>
									if isPostponed {
										<span class="ctag ctag-peach">Postponed</span>
									} else {
										<span class="ctag ctag-sky">Queued</span>
									}
								</td>
								<td>
									<form hx-post="/user/holds" hx-target="closest tr" hx-swap="outerHTML">
										<input type="hidden" name="action" value="cancel"/>
										<input type="hidden" name="hold_id" value={ hold.HoldID }/>
										<button type="submit" class="btn btn-danger-outline btn-sm">Cancel</button>
									</form>
								</td>
							</tr>
						}
					</tbody>
				</table>
			}
		</div>
	</main>
	@common.Footer()
}
