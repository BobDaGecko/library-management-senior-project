package pages

import "voxelprismatic/library-management-senior-project/web/common"

templ HoldsPage() {
	@common.Head("My Holds · Town Library", "View and manage your requested items.")
	<body class="bg-base">
		@common.NavHead("Account", "")

		<!-- Sub nav matching account/public pattern -->
		<nav class="mt-2" style="border-bottom: solid var(--tertiary);">
			<div class="navbar-collapse justify-between">
				<ul class="navbar-nav">
					<li><a href="#">Explore <i class="material-icons">arrow_drop_down</i></a></li>
					<li><a href="#">Services <i class="material-icons">arrow_drop_down</i></a></li>
					<li><a href="#">Events <i class="material-icons">arrow_drop_down</i></a></li>
					<li><a href="#">About Us <i class="material-icons">arrow_drop_down</i></a></li>
				</ul>
				<ul class="navbar-nav">
					<li><a href="/account"><i class="material-icons mb-2">account_circle</i> My Account</a></li>
					<li><a href="/help"><i class="material-icons mb-2">help</i> Help</a></li>
				</ul>
			</div>
		</nav>

		<main class="container-lg mt-8">
			<header class="between mb-6">
				<div>
					<h1>My Holds</h1>
					<p class="text-muted">
						View and manage your requested items.
					</p>
				</div>

				<a href="/account" class="btn btn-link">
					← Back to Account
				</a>
			</header>

			<!-- Sorting Controls -->
			<div class="between mb-4">
				<span class="text-sm text-muted">
					Showing current holds
				</span>

				<select class="form-input select w-fit">
					<option>Sort by requested date</option>
					<option>Sort by status</option>
				</select>
			</div>

			<!-- Holds List -->
			<ul class="list border rounded">

				<li class="list-item">
					<div>
						<h3>
							<a href="/">Modern World History</a>
						</h3>
						<p class="text-sm text-muted">
							Format: Book · Requested May 20, 2026
						</p>
					</div>

					<span class="badge badge-success">
						Ready for pickup
					</span>

					<button class="btn btn-danger btn-sm ml-auto">
						Cancel
					</button>
				</li>

				<li class="list-item">
					<div>
						<h3>
							<a href="/">History Through Stories</a>
						</h3>
						<p class="text-sm text-muted">
							Format: eBook · Requested May 18, 2026
						</p>
					</div>

					<span class="badge badge-warning">
						Waiting
					</span>

					<button class="btn btn-danger btn-sm ml-auto">
						Cancel
					</button>
				</li>

				<li class="list-item">
					<div>
						<h3>
							<a href="/">The Great Adventure</a>
						</h3>
						<p class="text-sm text-muted">
							Format: Audiobook · Requested May 15, 2026
						</p>
					</div>

					<span class="badge badge-error">
						On hold
					</span>

					<button class="btn btn-danger btn-sm ml-auto">
						Cancel
					</button>
				</li>

			</ul>
		</main>

		@common.Footer()
	</body>
}
