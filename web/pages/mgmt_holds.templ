package pages

import (
	"fmt"
	"time"
	"voxelprismatic/library-management-senior-project/db"
	"voxelprismatic/library-management-senior-project/router/fail"
	"voxelprismatic/library-management-senior-project/web/common"
)

// getOpenHolds loads open holds via a raw SQL JOIN. Hold.BookWorkID stores raw
// Google Books string IDs, so a plain Find(&holds)+Preload("BookWork") fails the
// SqlUUID scan and corrupts every row (see CLAUDE.md). We hydrate db.Hold values
// manually so the template can keep using h.User / h.BookWork.Title / h.Status().
func getOpenHolds() []db.Hold {
	type holdRow struct {
		ID            string
		UserID        string
		Format        int
		RequestedDate time.Time
		FirstName     string
		LastName      string
		Title         string
	}
	var rows []holdRow
	db.Db().Raw(`
		SELECT h.id, h.user_id, h.format, h.requested_date,
		       COALESCE(u.first_name, '') AS first_name,
		       COALESCE(u.last_name, '')  AS last_name,
		       COALESCE(bw.title, '')     AS title
		FROM holds h
		LEFT JOIN users u ON u.id = h.user_id
		LEFT JOIN book_works bw ON bw.id = h.book_work_id
		WHERE h.fulfilled_date = ? AND h.cancelled_date = ? AND h.deleted_at IS NULL
		ORDER BY h.requested_date ASC
	`, db.NilTime, db.NilTime).Scan(&rows)

	holds := make([]db.Hold, 0, len(rows))
	for _, r := range rows {
		uid, _ := db.FromString(r.UserID)
		hid, _ := db.FromString(r.ID)
		holds = append(holds, db.Hold{
			BaseModel:     db.BaseModel{ID: hid},
			UserID:        uid,
			User:          db.User{BaseModel: db.BaseModel{ID: uid}, FirstName: r.FirstName, LastName: r.LastName},
			Format:        db.BookFmtFlag(r.Format),
			RequestedDate: r.RequestedDate,
			BookWork:      db.BookWork{Title: r.Title},
		})
	}
	return holds
}

// MgmtHolds full page
templ MgmtHolds(p *fail.RoutingParams) {
	@common.Head("Holds — Management", "Library holds management")
	@common.MgmtNavHead(p.Req.URL.Path)
	<main class="page-main">
		<div class="container">
			<h1 class="mb-2">Holds</h1>
			<p class="text-sub mb-6">Active holds across all patrons. Cancel holds as needed — fulfillment happens automatically at checkout.</p>
			<div id="holds-container">
				@MgmtHoldsTable()
			</div>
		</div>
	</main>
	@common.Footer()
}

// MgmtHoldsTable renders the open-holds table.
templ MgmtHoldsTable() {
	{{ holds := getOpenHolds() }}
	if len(holds) == 0 {
		<div class="card-flat">
			<div class="empty-state">
				<i class="material-icons empty-state-icon">hourglass_empty</i>
				<p class="empty-state-text">No open holds.</p>
			</div>
		</div>
	} else {
		<table class="table">
			<thead>
				<tr>
					<th>Patron</th>
					<th>Title</th>
					<th>Format</th>
					<th>Requested</th>
					<th>Status</th>
					<th>Action</th>
				</tr>
			</thead>
			<tbody>
				for _, h := range holds {
					{{ status, _ := h.Status() }}
					<tr>
						<td>
							<a href={ templ.SafeURL(fmt.Sprintf("/management/users/%s", h.User.ID.String())) }>
								{ h.User.FirstName } { h.User.LastName }
							</a>
						</td>
						<td>@BookTitle(h.BookWork.Title)</td>
						<td><span class="ctag ctag-sky">{ h.Format.DisplayName() }</span></td>
						<td>{ h.RequestedDate.Format("2006-01-02") }</td>
						<td>@holdStatusCtag(status)</td>
						<td>
							<button
								class="btn btn-sm btn-subtle"
								hx-post="/management/holds"
								hx-vals={ fmt.Sprintf(`{"hold_id":"%s","action":"cancel"}`, h.ID.String()) }
								hx-confirm={ fmt.Sprintf("Cancel hold for %s %s on \"%s\"?", h.User.FirstName, h.User.LastName, bookTitleStr(h.BookWork.Title)) }
								hx-target="this"
								hx-swap="outerHTML"
							>Cancel</button>
						</td>
					</tr>
				}
			</tbody>
		</table>
	}
}

// HoldCancelledBadge replaces the cancel button after a successful cancellation.
templ HoldCancelledBadge() {
	<span class="ctag ctag-muted">Cancelled</span>
}
