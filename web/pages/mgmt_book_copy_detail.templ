					</tr>
				</thead>
				<tbody>
					for _, e := range entries {
						<tr>
							<td class="whitespace-nowrap">{ e.Date.Format("2006-01-02 15:04") }</td>
							<td>
								if e.Technician != "" {
									<span class="badge bg-teal-700 text-white px-2 py-0.5 rounded text-xs">Repair</span>
								} else {
									<span class="badge bg-blue-700 text-white px-2 py-0.5 rounded text-xs">User Return</span>
