	<div id="history-table" class="card card-flat">
		<div class="flex items-baseline justify-between mb-3">
			<h3 class="mb-0">Return &amp; Repair History</h3>
			<span class="text-sm text-sub">
				{ fmt.Sprintf("%d event(s)", total) }
			</span>
		</div>
		if len(entries) == 0 {
			<p class="copy-empty">No returns or repairs recorded for this copy yet.</p>
		} else {
			<table class="table">
				<thead>
					<tr>
						<th>Date</th>
						<th>Event</th>
						<th>By</th>
						<th>Condition</th>
					</tr>
				</thead>
				<tbody>
					for _, e := range entries {
						<tr>
							<td class="whitespace-nowrap text-sm">{ e.Date.Format("2006-01-02 15:04") }</td>
							<td>
								if e.Technician != "" {
									<span class="ctag ctag-teal">Repair</span>
								} else {
									<span class="ctag ctag-sky">Return</span>
								}
							</td>
							<td class="text-sm">
								if e.Technician != "" {
									{ e.Technician }
								} else {
									<a href={ templ.SafeURL("/management/users/" + e.UserID.String()) }>
										{ e.User.FirstName } { e.User.LastName }
									</a>
									if e.User.Email != "" {
										<span class="text-xs text-sub">({ e.User.Email })</span>
									}
								}
							</td>
							<td class="text-sm">
								if e.Technician != "" {
									<span class="text-sub">reset to good</span>
								} else {
									{ e.Condition.DisplayName() }
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		}
		@common.Pagination(
			"copy-history-pager",
			page,
			totalPages,
			"history-container",
			"/management/books/"+bookID+"/copies/"+c.ID.Short(),
		)
	</div>
}

// currentHolderBlock renders current checkout info (if the copy is out).
templ currentHolderBlock(c db.BookCopy) {
	if h := currentHolder(c); h != nil {
		<div class="mt-3 text-sm">
			Currently <strong>checked out</strong> to
			<a href={ templ.SafeURL("/management/users/" + h.User.ID.String()) } class="font-medium">
				{ h.User.FirstName } { h.User.LastName }
			</a>
			since { h.DateCheckout.Format("2006-01-02 15:04") }
			<span class="text-sub">(outgoing condition: { h.OutgoingCondition.DisplayName() })</span>
		</div>
	}
}
