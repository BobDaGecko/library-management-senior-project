	<div id="history-table" class="card card-flat">
		<div class="flex items-baseline justify-between mb-3">
			<h3 class="mb-0">Return &amp; Repair History</h3>
			<span class="text-sm text-secondary">
				Page { page } of { totalPages } — { total } event(s)
			</span>
		</div>
		if len(entries) == 0 {
			<p class="copy-empty">No returns or repairs recorded for this copy yet.</p>
		} else {
			<table class="table">
				<thead>
					<tr>
						<th>Date Returned</th>
						<th>Event</th>
						<th>By</th>
