			"/management/books/"+bookID+"/copies/"+c.ID.Short(),
		)
	</div>
}

// currentHolderBlock renders current checkout info (if the copy is out).
// Written with direct Go control flow (templ style) to satisfy the parser.
templ currentHolderBlock(c db.BookCopy) {
	if h := currentHolder(c); h != nil {
		<div class="mt-3 text-sm">
			Currently <strong>checked out</strong> to
			<a href={ templ.SafeURL("/management/users/" + h.User.ID.String()) } class="font-medium">
				{ h.User.FirstName } { h.User.LastName }
			</a>
			since { h.DateCheckout.Format("2006-01-02 15:04") }
			<span class="text-secondary">(outgoing condition: { h.OutgoingCondition.DisplayName() })</span>
		</div>
	}
}
