package pages

import (
	"fmt"
	"strings"

	"voxelprismatic/library-management-senior-project/db"
	"voxelprismatic/library-management-senior-project/router/fail"
	"voxelprismatic/library-management-senior-project/web/common"
)

// currentHolder returns the latest open loan (if any) for display purposes.
func currentHolder(c db.BookCopy) *db.Loan {
	hist, err := c.LoanHistory()
	if err != nil || len(hist) == 0 {
		return nil
	}
	if hist[0].DateReturned.IsZero() {
		return &hist[0]
	}
	return nil
}

// historyTotal queries the live count of return+repair events for a copy.
// Called directly from the template so the value is always fresh.
func historyTotal(c db.BookCopy) int64 {
	_, total, _ := c.History(1, 1)
	return total
}

// MgmtBookCopyDetail is the full detail + history page for one physical copy.
templ MgmtBookCopyDetail(bookID string, c db.BookCopy, entries []db.HistoryEntry, page, totalPages int, total int64, p *fail.RoutingParams) {
	@common.Head("Copy Detail — Management", "Physical copy detail and history")
	@common.MgmtNavHead(p.Req.URL.Path)
	<main class="page-main">
		<div class="container">
			<div class="flex items-center justify-between mb-4">
				<h1 class="mb-0">Copy Detail</h1>
				<a href={ templ.SafeURL("/management/books/" + bookID + "/copies") } class="btn btn-sm btn-subtle">← Copies</a>
			</div>
			@CopyManagementSection(bookID, c)
			<div id="history-container">
				@MgmtBookCopyHistory(bookID, c, entries, page, totalPages, total)
			</div>
		</div>
	</main>
	@common.Footer()
}

// CopyManagementSection is the HTMX-swappable wrapper covering the header card
// and actions card. POST action handlers return this fragment to update state.
templ CopyManagementSection(bookID string, c db.BookCopy) {
	<div id="copy-management">
		@copyHeaderCard(bookID, c)
		@copyActionsCard(bookID, c)
	</div>
}

// CopyManagementWithHistoryOOB is returned after complete_repair so HTMX can
// simultaneously update the management section and the history table.
templ CopyManagementWithHistoryOOB(bookID string, c db.BookCopy, entries []db.HistoryEntry, page, totalPages int, histTotal int64) {
	@CopyManagementSection(bookID, c)
	<div id="history-container" hx-swap-oob="outerHTML">
		@MgmtBookCopyHistory(bookID, c, entries, page, totalPages, histTotal)
	</div>
}

// copyHeaderCard renders the identity + status tags for a copy.
templ copyHeaderCard(bookID string, c db.BookCopy) {
	{{ loanStatus, _ := c.LoanStatus() }}
	<div class="card card-flat mb-4">
		<div class="flex gap-4 items-start">
			<a
				class="copy-thumb"
				style="width:72px;height:72px;font-size:18px;flex-shrink:0;"
				href={ templ.SafeURL("/management/books/" + c.BookWorkID + "/copies/" + c.ID.Short()) }
			>
				for _, part := range c.ID.Thumb() {
					<span class="id-row">{ part }</span>
				}
			</a>
			<div class="flex-1">
				<div class="text-xs text-sub">Short ID</div>
				<div class="font-mono font-semibold tracking-wider mb-1" style="font-size: var(--fs-lg);">{ c.ID.Short() }</div>
				<div class="text-xs text-sub break-all mb-3">{ c.ID.String() }</div>
				if c.BookWork.Title != "" {
					<div class="mb-3">
						<span class="text-sub">Book: </span>
						<a href={ templ.SafeURL("/management/books/" + bookID) } class="font-medium">
							{ c.BookWork.Title }
						</a>
						if len(c.BookWork.Authors) > 0 {
							<span class="text-sub"> by { strings.Join(c.BookWork.Authors, ", ") }</span>
						}
					</div>
				}
				<div class="flex flex-wrap gap-2">
					<span class="ctag ctag-peach">{ c.Format.DisplayName() }</span>
					@copyConditionTag(c.Condition)
					@copyCirculationTag(c.Status)
					@copyLoanTag(loanStatus)
				</div>
				@currentHolderBlock(c)
			</div>
		</div>
	</div>
}

templ copyConditionTag(cond db.ConditionFlag) {
	switch cond {
	case db.ConditionMint:
		<span class="ctag ctag-green">mint</span>
	case db.ConditionGood:
		<span class="ctag ctag-teal">good</span>
	case db.ConditionFair:
		<span class="ctag ctag-sky">fair</span>
	default:
		<span class="ctag ctag-peach">{ cond.DisplayName() }</span>
	}
}

templ copyCirculationTag(status db.CopyStatusFlag) {
	switch status {
	case db.CopyStatusPublic:
		<span class="ctag ctag-green">in circulation</span>
	case db.CopyStatusRepairing:
		<span class="ctag ctag-peach">repairing</span>
	case db.CopyStatusPendingReturn:
		<span class="ctag ctag-sky">pending return</span>
	case db.CopyStatusPendingAction:
		<span class="ctag ctag-sky">pending action</span>
	case db.CopyStatusDiscarded:
		<span class="ctag ctag-muted">discarded</span>
	default:
		<span class="ctag ctag-muted">{ status.DisplayName() }</span>
	}
}

templ copyLoanTag(ls db.CopyLoanFlag) {
	switch ls {
	case db.CopyLoanAvailable:
		<span class="ctag ctag-green">available</span>
	case db.CopyLoanUnavailable:
		<span class="ctag ctag-sky">checked out</span>
	case db.CopyLoanOverdue:
		<span class="ctag ctag-red">overdue</span>
	case db.CopyLoanWithdrawn:
		<span class="ctag ctag-peach">withheld</span>
	default:
		<span class="ctag ctag-muted">{ ls.DisplayName() }</span>
	}
}

// copyActionsCard renders management actions appropriate to the copy's current state.
templ copyActionsCard(bookID string, c db.BookCopy) {
	{{ postURL := "/management/books/" + bookID + "/copies/" + c.ID.Short() }}
	{{ histTotal := historyTotal(c) }}
	<div class="card card-flat mb-6" id="copy-actions">
		<h3 class="mb-4">Manage Copy</h3>
		<!-- Primary actions based on circulation status -->
		if c.Status == db.CopyStatusRepairing {
			<p class="text-sm text-sub mb-3">This copy is currently out for repair. Record the outcome to return it to circulation.</p>
			<form
				hx-post={ postURL }
				hx-target="#copy-management"
				hx-swap="outerHTML"
			>
				<input type="hidden" name="action" value="complete_repair"/>
				<div class="flex flex-wrap gap-3 items-end">
					<div class="form-group mb-0">
						<label class="form-label" for="tech-name">Technician</label>
						<input id="tech-name" name="technician" class="form-input" required placeholder="Name"/>
					</div>
					<div class="form-group mb-0">
						<label class="form-label" for="repair-condition">Resulting Condition</label>
						<select id="repair-condition" name="condition" class="form-input">
							<option value="0">Mint</option>
							<option value="1" selected>Good</option>
							<option value="2">Fair</option>
							<option value="3">Poor</option>
						</select>
					</div>
					<button class="btn btn-primary" type="submit">
						<i class="material-icons" style="font-size:16px;vertical-align:-3px;">check_circle</i>
						Complete Repair
					</button>
				</div>
			</form>
		} else if c.Status == db.CopyStatusPendingAction {
			<p class="text-sm text-sub mb-3">This copy has been returned and is awaiting a decision.</p>
			<div class="flex flex-wrap gap-2">
				<form hx-post={ postURL } hx-target="#copy-management" hx-swap="outerHTML">
					<input type="hidden" name="action" value="restore"/>
					<button class="btn btn-sm btn-subtle" type="submit">
						<i class="material-icons" style="font-size:14px;vertical-align:-2px;">replay</i>
						Return to Circulation
					</button>
				</form>
				<form hx-post={ postURL } hx-target="#copy-management" hx-swap="outerHTML">
					<input type="hidden" name="action" value="start_repair"/>
					<button class="btn btn-sm btn-subtle" type="submit">
						<i class="material-icons" style="font-size:14px;vertical-align:-2px;">build</i>
						Send to Repair
					</button>
				</form>
			</div>
		} else if c.Status == db.CopyStatusDiscarded {
			<p class="text-sm text-sub mb-3">This copy has been discarded and is no longer in circulation.</p>
			<form hx-post={ postURL } hx-target="#copy-management" hx-swap="outerHTML">
				<input type="hidden" name="action" value="restore"/>
				<button class="btn btn-sm btn-subtle" type="submit">
					<i class="material-icons" style="font-size:14px;vertical-align:-2px;">replay</i>
					Restore to Circulation
				</button>
			</form>
		} else if c.Status == db.CopyStatusPublic {
			{{ isOut := currentHolder(c) != nil }}
			if isOut {
				<p class="text-sm text-sub mb-3">This copy is currently checked out. It can be sent to repair once returned.</p>
			} else {
				<p class="text-sm text-sub mb-3">Send this copy out for repair, or discard it if it is beyond use.</p>
				<form hx-post={ postURL } hx-target="#copy-management" hx-swap="outerHTML">
					<input type="hidden" name="action" value="start_repair"/>
					<div class="flex flex-wrap gap-3 items-end">
						<div class="form-group" style="margin-bottom: 0">
							<label class="form-label" for="tech-start">Technician (optional)</label>
							<input id="tech-start" name="technician" class="form-input" placeholder="Name"/>
						</div>
						<button class="btn btn-subtle" type="submit">
							<i class="material-icons" style="font-size:16px;vertical-align:-3px;">build</i>
							Send to Repair
						</button>
					</div>
				</form>
			}
		}
		<!-- Danger zone -->
		<div class="mt-6 pt-4" style="border-top: var(--border-w) solid var(--border);">
			<p class="text-xs text-sub mb-3" style="font-weight:600;letter-spacing:0.05em;text-transform:uppercase;">Danger Zone</p>
			<div class="flex flex-wrap gap-2">
				if c.Status != db.CopyStatusDiscarded {
					<button
						class="btn btn-sm btn-danger"
						hx-post={ postURL }
						hx-vals={ fmt.Sprintf(`{"action":"discard"}`) }
						hx-target="#copy-management"
						hx-swap="outerHTML"
						hx-confirm="Mark this copy as discarded? It will be removed from circulation."
					>
						<i class="material-icons" style="font-size:14px;vertical-align:-2px;">delete_sweep</i>
						Discard Copy
					</button>
				}
				if histTotal == 0 {
					<button
						class="btn btn-sm btn-danger"
						hx-post={ postURL }
						hx-vals={ fmt.Sprintf(`{"action":"delete"}`) }
						hx-confirm="Permanently delete this copy? This cannot be undone."
						hx-swap="none"
					>
						<i class="material-icons" style="font-size:14px;vertical-align:-2px;">delete_forever</i>
						Delete Copy
					</button>
				}
			</div>
		</div>
	</div>
}

// MgmtBookCopyHistory is the card containing the history table + header + pager.
templ MgmtBookCopyHistory(bookID string, c db.BookCopy, entries []db.HistoryEntry, page, totalPages int, total int64) {
	<div id="history-table" class="card card-flat">
		<div class="flex items-baseline justify-between mb-3">
			<h3 class="mb-0">Return &amp; Repair History</h3>
			<span class="text-sm text-sub">
				{ fmt.Sprintf("%d event(s)", total) }
			</span>
		</div>
		if len(entries) == 0 {
			<p class="copy-empty">No returns or repairs recorded for this copy yet.</p>
		} else {
			<table class="table">
				<thead>
					<tr>
						<th>Date</th>
						<th>Event</th>
						<th>By</th>
						<th>Condition</th>
					</tr>
				</thead>
				<tbody>
					for _, e := range entries {
						<tr>
							<td class="whitespace-nowrap text-sm">{ e.Date.Format("2006-01-02 15:04") }</td>
							<td>
								if e.Technician != "" {
									<span class="ctag ctag-teal">Repair</span>
								} else {
									<span class="ctag ctag-sky">Return</span>
								}
							</td>
							<td class="text-sm">
								if e.Technician != "" {
									{ e.Technician }
								} else {
									<a href={ templ.SafeURL("/management/users/" + e.UserID.String()) }>
										{ e.User.FirstName } { e.User.LastName }
									</a>
									if e.User.Email != "" {
										<span class="text-xs text-sub">({ e.User.Email })</span>
									}
								}
							</td>
							<td class="text-sm">
								if e.Technician != "" {
									<span class="text-sub">reset to good</span>
								} else {
									{ e.Condition.DisplayName() }
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		}
		@common.Pagination(
			"copy-history-pager",
			page,
			totalPages,
			"history-container",
			"/management/books/"+bookID+"/copies/"+c.ID.Short(),
		)
	</div>
}

// MgmtBookCopyHistoryTable is the fragment returned for HTMX pagination updates.
