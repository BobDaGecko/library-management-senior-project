package pages

import (
	"strings"

	"voxelprismatic/library-management-senior-project/db"
	"voxelprismatic/library-management-senior-project/router/fail"
	"voxelprismatic/library-management-senior-project/web/common"
)

// PostDef holds all content for a hardcoded blog post.
type PostDef struct {
	ID               string
	Title            string
	Date             string
	Tags             []string
	Body             []string // paragraphs
	FeaturedCategory string   // empty = no featured section
}

var blogPosts = []PostDef{
	{
		ID:    "1",
		Title: "Staff Picks: Summer Reading",
		Date:  "June 2026",
		Tags:  []string{"Staff Picks", "Fiction"},
		Body: []string{
			"Summer is the perfect time to lose yourself in a great book. Our librarians have assembled their favorite fiction titles that are ideal for the season — stories that transport you to distant places, make you feel deeply, and leave you thinking long after you've turned the last page.",
			"From sweeping historical novels to intimate character studies and gripping thrillers, there's something in this list for every kind of reader. These picks have been loved by staff members across all of our branches.",
			"Stop by your nearest branch or browse our digital collection to reserve any of these titles today. Happy reading!",
		},
		FeaturedCategory: "fiction",
	},
	{
		ID:    "2",
		Title: "New Arrivals — June 2026",
		Date:  "June 2026",
		Tags:  []string{"New Arrivals", "Non-fiction"},
		Body: []string{
			"Our collection has grown significantly this month, with a particular focus on recent non-fiction. From in-depth explorations of world history to accessible science writing and compelling memoirs, these new additions reflect the breadth of human experience.",
			"We've worked closely with our subject librarians to identify titles that fill gaps in our collection and respond to patron requests. If you've been waiting for a specific topic to come in, now might be your moment.",
			"Use our catalog search to check availability, or ask at any branch desk — staff are happy to help you find your next great read.",
		},
		FeaturedCategory: "history",
	},
	{
		ID:    "3",
		Title: "A Note from Our Librarians",
		Date:  "June 2026",
		Tags:  []string{"Community", "Announcements"},
		Body: []string{
			"Welcome to the Town Library community! Whether you've been a patron for decades or you're visiting for the first time, we're so glad you're here. Libraries are more than buildings filled with books — they are spaces for curiosity, connection, and lifelong learning.",
			"Our team is committed to making every visit — in person or online — a great experience. We're continuously updating our digital resources, expanding our catalog, and planning community events throughout the year.",
			"If you ever have suggestions, questions, or just want to say hello, please reach out at the front desk or through our website. This library belongs to all of you.",
		},
		FeaturedCategory: "", // no featured books section
	},
}

func FindPost(id string) (PostDef, bool) {
	for _, p := range blogPosts {
		if p.ID == id {
			return p, true
		}
	}
	return PostDef{}, false
}

func featuredBooks(category string) []db.BookWork {
	var results []db.BookWork
	db.Db().Where("lower(categories) LIKE ?", "%"+strings.ToLower(category)+"%").
		Limit(3).Find(&results)
	return results
}

func blogTagColor(tag string) string {
	switch strings.ToLower(tag) {
	case "staff picks":
		return "ctag-teal"
	case "fiction":
		return "ctag-sky"
	case "new arrivals":
		return "ctag-green"
	case "community":
		return "ctag-peach"
	default:
		return "ctag-muted"
	}
}

templ BlogDetailsPage(p *fail.RoutingParams, post PostDef) {
	@common.Head(post.Title + " · Town Library", "Read the full blog post and discover featured books from the Town Library staff picks.")
	@common.NavHead(p.User, p.Req.URL.Path, "")
	<main class="page-main">
		<div class="container">
			<a href="/blog" class="btn btn-subtle mb-4">← Back to Blog</a>
			<article>
				<h1>{ post.Title }</h1>
				<p class="text-sub text-sm">Posted { post.Date } · by Library Staff</p>
				<div class="mt-2 mb-4">
					for _, tag := range post.Tags {
						<span class={ "ctag " + blogTagColor(tag) }>{ tag }</span>
					}
				</div>
				for _, para := range post.Body {
					<p>{ para }</p>
				}
				if post.FeaturedCategory != "" {
					{{ books := featuredBooks(post.FeaturedCategory) }}
					if len(books) > 0 {
						<section class="mt-8">
							<h2>Featured Books</h2>
							<div class="blog-featured-grid">
								for _, b := range books {
									<div class="blog-featured-card">
										if b.CoverThumb != "" {
											<img src={ b.CoverThumb } alt={ b.Title } class="blog-featured-cover"/>
										}
										<div>
											<a href={ templ.SafeURL("/book/" + b.ID) }>{ b.Title }</a>
											if len(b.Authors) > 0 {
												<p class="text-sub">{ strings.Join(b.Authors, ", ") }</p>
											}
										</div>
									</div>
								}
							</div>
						</section>
					}
				}
			</article>
		</div>
	</main>
	@common.Footer()
}
