package pages

import (
	"voxelprismatic/library-management-senior-project/router/fail"
	"voxelprismatic/library-management-senior-project/web/common"
	"voxelprismatic/library-management-senior-project/web/user"
)

// LoginPage is the full patron login page.
templ LoginPage(p *fail.RoutingParams) {
	@common.Head("Log In · Town Library", "Log in to your Town Library account.")
	@common.NavHead(nil, "/user/login", "")
	<main class="page-main">
		<div class="container">
			<div class="auth-page-center">
				<div class="card-flat auth-card">
					<h1 class="auth-heading">Welcome back</h1>
					<p class="text-sub auth-subheading">Log in to access your loans, holds, and fines.</p>
					<form hx-post="/user/login" hx-target="#formEntry" hx-swap="outerHTML">
						@user.FormTable(user.LoginFormEntries, map[string]string{}, map[string]error{})
						<button type="submit" class="btn btn-primary auth-submit-btn">Log In</button>
					</form>
					<p class="auth-alt-link">Don't have an account? <a href="/user/register">Register →</a></p>
				</div>
			</div>
		</div>
	</main>
	@common.Footer()
}
