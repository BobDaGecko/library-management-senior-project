package pages

import (
	"fmt"
	"time"
	"voxelprismatic/library-management-senior-project/db"
	"voxelprismatic/library-management-senior-project/router/fail"
	"voxelprismatic/library-management-senior-project/web/book"
	"voxelprismatic/library-management-senior-project/web/common"
)

func getLatestBooks(limit int) []db.BookWork {
	var books []db.BookWork
	db.Db().Model(&db.BookWork{}).Order("created_at desc").Limit(limit).Find(&books)
	return books
}

func countBooks() int64 {
	var n int64
	db.Db().Model(&db.BookWork{}).Count(&n)
	return n
}

func countCopies() int64 {
	var n int64
	db.Db().Model(&db.BookCopy{}).Count(&n)
	return n
}

func countActiveLoans() int64 {
	var n int64
	db.Db().Model(&db.Loan{}).Where("date_returned = ?", db.NilTime).Count(&n)
	return n
}

func countOverdueLoans() int64 {
	var n int64
	db.Db().Model(&db.Loan{}).
		Where("date_returned = ?", db.NilTime).
		Where("date_checkout < ?", time.Now().Add(-db.LOAN_DURATION)).
		Count(&n)
	return n
}

func countOpenHolds() int64 {
	var n int64
	db.Db().Model(&db.Hold{}).
		Where("fulfilled_date = ?", db.NilTime).
		Where("cancelled_date = ?", db.NilTime).
		Count(&n)
	return n
}

func sumOutstandingFines() float64 {
	var total float64
	db.Db().Model(&db.Fine{}).
		Where("amount_remaining > 0").
		Select("COALESCE(SUM(amount_remaining), 0)").
		Scan(&total)
	return total
}

func countUsers() int64 {
	var n int64
	db.Db().Model(&db.User{}).Where("status != ?", db.UserStatusDeleted).Count(&n)
	return n
}

func getRecentLoans(limit int) []db.Loan {
	var loans []db.Loan
	db.Db().Model(&db.Loan{}).
		Where("date_returned != ?", db.NilTime).
		Order("date_returned desc").
		Limit(limit).
		Preload("User").
		Preload("BookCopy.BookWork").
		Find(&loans)
	return loans
}

func getAttentionUsers(limit int) []db.User {
	var users []db.User
	db.Db().Raw(`
		SELECT DISTINCT u.* FROM users u
		LEFT JOIN loans l ON l.user_id = u.id AND l.date_returned = ? AND l.date_checkout < ?
		LEFT JOIN fines f ON f.user_id = u.id AND f.amount_remaining > 0
		WHERE u.deleted_at IS NULL AND u.status != ? AND (l.id IS NOT NULL OR f.id IS NOT NULL)
		LIMIT ?
	`, db.NilTime, time.Now().Add(-db.LOAN_DURATION), db.UserStatusDeleted, limit).Scan(&users)
	return users
}

templ ManagementHome(p *fail.RoutingParams) {
	@common.Head("Dashboard — Management", "Library management dashboard")
	@common.MgmtNavHead(p.Req.URL.Path)
	<main class="page-main">
		<div class="container">
			<div class="flex items-center justify-between mb-6">
				<h1>Dashboard</h1>
				<div class="flex gap-2">
					<a href="/management/books/add" class="btn btn-primary btn-sm">
						<i class="material-icons" style="font-size:16px;vertical-align:-3px;">add</i>
						Add Books
					</a>
				</div>
			</div>
			<!-- Stats row -->
			<div class="stat-grid mb-8">
				<div class="stat-card">
					<div class="stat-icon"><i class="material-icons">menu_book</i></div>
					<div class="stat-value">{ fmt.Sprintf("%d", countBooks()) }</div>
					<div class="stat-label">Titles in Catalog</div>
				</div>
				<div class="stat-card">
					<div class="stat-icon"><i class="material-icons">inventory_2</i></div>
					<div class="stat-value">{ fmt.Sprintf("%d", countCopies()) }</div>
					<div class="stat-label">Physical Copies</div>
				</div>
				<div class="stat-card">
					<div class="stat-icon"><i class="material-icons">bookmark</i></div>
					<div class="stat-value">{ fmt.Sprintf("%d", countActiveLoans()) }</div>
					<div class="stat-label">Active Loans</div>
				</div>
				<div class={ "stat-card", templ.KV("stat-warn", countOverdueLoans() > 0) }>
					<div class="stat-icon"><i class="material-icons">schedule</i></div>
					<div class="stat-value">{ fmt.Sprintf("%d", countOverdueLoans()) }</div>
					<div class="stat-label">Overdue</div>
				</div>
				<div class="stat-card">
					<div class="stat-icon"><i class="material-icons">hourglass_top</i></div>
					<div class="stat-value">{ fmt.Sprintf("%d", countOpenHolds()) }</div>
					<div class="stat-label">Open Holds</div>
				</div>
				<div class={ "stat-card", templ.KV("stat-alert", sumOutstandingFines() > 0) }>
					<div class="stat-icon"><i class="material-icons">payments</i></div>
					<div class="stat-value">{ fmt.Sprintf("$%.0f", sumOutstandingFines()) }</div>
					<div class="stat-label">Outstanding Fines</div>
				</div>
				<div class="stat-card">
					<div class="stat-icon"><i class="material-icons">people</i></div>
					<div class="stat-value">{ fmt.Sprintf("%d", countUsers()) }</div>
					<div class="stat-label">Registered Users</div>
				</div>
			</div>
			<!-- Quick actions -->
			<div class="card-flat mb-8">
				<h3 class="mb-4">Quick Actions</h3>
				<div class="flex gap-3">
					<a href="/management/checkout" class="btn btn-primary">
						<i class="material-icons" style="font-size:16px;vertical-align:-3px;">login</i>
						Checkout Book
					</a>
					<a href="/management/return" class="btn btn-secondary">
						<i class="material-icons" style="font-size:16px;vertical-align:-3px;">logout</i>
						Process Return
					</a>
					<a href="/management/overdue" class="btn btn-ghost">
						<i class="material-icons" style="font-size:16px;vertical-align:-3px;">schedule</i>
						View Overdue
					</a>
				</div>
			</div>
			<!-- Bottom two-column grid: recent activity + attention needed -->
			<div class="two-col gap-6">
				<!-- Recently returned -->
				<div class="card-flat">
					<h3 class="mb-4">Recently Returned</h3>
					if len(getRecentLoans(5)) == 0 {
						<p class="text-sub">No returns yet.</p>
					} else {
						<table class="table">
							<thead>
								<tr>
									<th>Book</th>
									<th>Patron</th>
									<th>Returned</th>
								</tr>
							</thead>
							<tbody>
								for _, l := range getRecentLoans(5) {
									<tr>
										<td>{ l.BookCopy.BookWork.Title }</td>
										<td>
											<a href={ templ.SafeURL("/management/users/" + l.User.ID.String()) }>
												{ l.User.FirstName } { l.User.LastName }
											</a>
										</td>
										<td class="text-sub" style="white-space:nowrap;">{ l.DateReturned.Format("Jan 2") }</td>
									</tr>
								}
							</tbody>
						</table>
					}
				</div>
				<!-- Needs attention -->
				<div class="card-flat">
					<h3 class="mb-4">Needs Attention</h3>
					if len(getAttentionUsers(5)) == 0 {
						<p class="text-sub">No outstanding issues.</p>
					} else {
						<table class="table">
							<thead>
								<tr>
									<th>Patron</th>
									<th>Email</th>
								</tr>
							</thead>
							<tbody>
								for _, u := range getAttentionUsers(5) {
									<tr>
										<td>
											<a href={ templ.SafeURL("/management/users/" + u.ID.String()) }>
												{ u.FirstName } { u.LastName }
											</a>
										</td>
										<td class="text-sub">{ u.Email }</td>
									</tr>
								}
							</tbody>
						</table>
					}
				</div>
			</div>
			<!-- Catalog section -->
			<div class="card-flat mt-8">
				<div class="flex items-center justify-between mb-4">
					<h3>Recently Added to Catalog</h3>
					<a href="/management/books/add" class="text-sm">Add more →</a>
				</div>
				<div class="main three-col">
					for _, b := range getLatestBooks(9) {
						@book.BookCover(b)
					}
				</div>
			</div>
		</div>
	</main>
	@common.Footer()
}
