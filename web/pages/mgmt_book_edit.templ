package pages

import (
	"fmt"
	"strings"
	"time"

	"voxelprismatic/library-management-senior-project/db"
	"voxelprismatic/library-management-senior-project/router/fail"
	"voxelprismatic/library-management-senior-project/web/common"
)

func bookEditHeadTitle(b db.BookWork) string {
	if b.Title != "" {
		return "Edit " + b.Title + " — Management"
	}
	return "Edit Book — Management"
}

func formatDateInput(t time.Time) string {
	if t.IsZero() {
		return ""
	}
	return t.Format("2006-01-02")
}

func joinLines(l db.SqlStringList) string {
	return strings.Join([]string(l), "\n")
}

// MgmtBookEdit is the metadata edit form for an existing BookWork at /management/books/:id/edit
templ MgmtBookEdit(bookID string, book db.BookWork, p *fail.RoutingParams) {
	@common.Head(bookEditHeadTitle(book), "Edit book metadata and details")
	@common.MgmtNavHead(p.Req.URL.Path)
	<main class="page-main">
		<div class="container">
			<div class="flex items-center justify-between mb-6">
				<div>
					<h1 class="mb-1">Edit Book</h1>
					if book.Title != "" {
						<p class="text-sub mb-0">
							{ book.Title }
							if len(book.Authors) > 0 {
								<span> by { strings.Join(book.Authors, ", ") }</span>
							}
						</p>
					} else {
						<p class="text-sub mb-0">ID: { bookID }</p>
					}
				</div>
				<div class="flex gap-2">
					<a href={ templ.SafeURL("/management/books/" + bookID + "/copies") } class="btn btn-sm btn-subtle">
						<i class="material-icons" style="font-size:14px;vertical-align:-2px;">library_books</i>
						Copies
					</a>
					<a href={ templ.SafeURL("/management/books/" + bookID) } class="btn btn-sm btn-subtle">← Detail</a>
				</div>
			</div>
			<div class="card card-flat">
				<div class="flex gap-6 mb-6 items-start">
					{{ coverSrc := "" }}
					if book.CoverImage != "" {
						{{ coverSrc = book.CoverImage }}
					} else if book.CoverThumb != "" {
						{{ coverSrc = book.CoverThumb }}
					}
					if coverSrc != "" {
						<img
							src={ coverSrc }
							alt={ book.Title + " cover" }
							style="width:90px;height:130px;object-fit:cover;border-radius:var(--radius);border:var(--border-w) solid var(--border);flex-shrink:0;"
						/>
					}
					<div class="flex-1 text-sm">
						<div class="mb-1"><span class="text-sub">Google Books ID: </span><code>{ bookID }</code></div>
						if book.Publisher != "" {
							<div class="mb-1"><span class="text-sub">Publisher: </span>{ book.Publisher }</div>
						}
						if !book.PublishedDate.IsZero() {
							<div class="mb-1"><span class="text-sub">Published: </span>{ book.PublishedDate.Format("2006") }</div>
						}
						if book.PageCount > 0 {
							<div class="mb-1"><span class="text-sub">Pages: </span>{ fmt.Sprintf("%d", book.PageCount) }</div>
						}
						<div class="mt-3">
							<button
								class="btn btn-sm btn-subtle"
								hx-put={ "/management/books/" + bookID }
								hx-swap="none"
								hx-confirm="Re-fetch fresh metadata from Google Books? This will overwrite your local edits."
							>
								<i class="material-icons" style="font-size:14px;vertical-align:-2px;">refresh</i>
								Re-fetch from Google Books
							</button>
						</div>
					</div>
				</div>
				<form hx-patch={ "/management/books/" + bookID } hx-swap="none">
					<div class="grid" style="grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: var(--space-4) var(--space-6);">
						<div class="form-group">
							<label class="form-label">Title</label>
							<input name="Title" class="form-input" value={ book.Title }/>
						</div>
						<div class="form-group">
							<label class="form-label">Subtitle</label>
							<input name="Subtitle" class="form-input" value={ book.Subtitle }/>
						</div>
						<div class="form-group">
							<label class="form-label">Authors <span class="text-sub">(one per line)</span></label>
							<textarea name="Authors" class="form-input" rows="4">{ joinLines(book.Authors) }</textarea>
						</div>
						<div class="form-group">
							<label class="form-label">Categories <span class="text-sub">(one per line)</span></label>
							<textarea name="Categories" class="form-input" rows="4">{ joinLines(book.Categories) }</textarea>
						</div>
						<div class="form-group">
							<label class="form-label">Publisher</label>
							<input name="Publisher" class="form-input" value={ book.Publisher }/>
						</div>
						<div class="form-group">
							<label class="form-label">Publication Date</label>
							<input name="PublishedDate" type="date" class="form-input" value={ formatDateInput(book.PublishedDate) }/>
						</div>
						<div class="form-group">
							<label class="form-label">Page Count</label>
							<input name="PageCount" type="number" min="0" class="form-input" value={ fmt.Sprintf("%d", book.PageCount) }/>
						</div>
						<div class="form-group">
							<label class="form-label">Version <span class="text-sub">(from Google)</span></label>
							<input name="Version" class="form-input" value={ book.Version } readonly/>
						</div>
						<div class="form-group">
							<label class="form-label">ISBN-13</label>
							<input name="Isbn13" class="form-input" value={ book.Isbn13 } readonly/>
						</div>
						<div class="form-group">
							<label class="form-label">ISBN-10</label>
							<input name="Isbn10" class="form-input" value={ book.Isbn10 } readonly/>
						</div>
						<div class="form-group">
							<label class="form-label">Cover Thumbnail URL</label>
							<input name="CoverThumb" class="form-input" value={ book.CoverThumb }/>
						</div>
						<div class="form-group">
							<label class="form-label">Cover Image URL</label>
							<input name="CoverImage" class="form-input" value={ book.CoverImage }/>
						</div>
					</div>
					<div class="form-group mt-2">
						<label class="form-label">Description</label>
						<textarea name="Description" class="form-input" rows="5">{ book.Description }</textarea>
					</div>
					<div class="form-group">
						<label class="flex items-center gap-2 cursor-pointer">
							<input type="hidden" name="IsMature" value="false"/>
							<input type="checkbox" name="IsMature" value="true" checked?={ book.IsMature }/>
							<span>Mature / adult content</span>
						</label>
					</div>
					<div class="flex gap-3 mt-4">
						<button type="submit" class="btn btn-primary">Save Changes</button>
						<a href={ templ.SafeURL("/management/books/" + bookID) } class="btn btn-ghost">Cancel</a>
					</div>
					<p class="text-xs text-sub mt-2">Saving will redirect to the book detail page.</p>
				</form>
			</div>
		</div>
	</main>
	@common.Footer()
}
