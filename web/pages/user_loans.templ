package pages

import (
	"fmt"
	"time"

	"voxelprismatic/library-management-senior-project/db"
	"voxelprismatic/library-management-senior-project/router/fail"
	"voxelprismatic/library-management-senior-project/web/common"
)

func loanStatusInfo(l db.Loan) (string, string) {
	if l.Status() == db.LoanStatusOverdue {
		return "Overdue", "ctag-peach"
	}
	due := l.DateCheckout.Add(db.LOAN_DURATION)
	if time.Until(due) < 3*24*time.Hour {
		return "Due soon", "ctag-yellow"
	}
	return "On time", "ctag-teal"
}

templ LoansPage(p *fail.RoutingParams, loans []db.Loan) {
	@common.Head("My Loans · Town Library", "View your currently checked-out items and due dates.")
	@common.NavHead(p.User, p.Req.URL.Path, "")
	<main class="page-main">
		<div class="container">
			<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:var(--space-6)">
				<div>
					<h1>My Loans</h1>
					<p class="text-sub">{ fmt.Sprintf("%d active loan", len(loans)) }{ pluralS(len(loans)) }</p>
				</div>
				<a href="/user" class="btn btn-subtle">← Back to Account</a>
			</div>
			if len(loans) == 0 {
				<div class="empty-state">
					<div class="empty-state-icon"><i class="material-icons">menu_book</i></div>
					<p class="empty-state-text">You have no active loans.</p>
				</div>
			} else {
				<table class="table">
					<thead>
						<tr>
							<th>Title</th>
							<th>Format</th>
							<th>Checked Out</th>
							<th>Due Date</th>
							<th>Status</th>
						</tr>
					</thead>
					<tbody>
						for _, loan := range loans {
							{{ text, ctagClass := loanStatusInfo(loan) }}
							{{ due := loan.DateCheckout.Add(db.LOAN_DURATION) }}
							<tr>
								<td>
									if loan.BookCopy.BookWork.Title != "" {
									<a href={ templ.SafeURL("/book/" + loan.BookCopy.BookWork.ID) }>
										{ loan.BookCopy.BookWork.Title }
									</a>
								} else {
									<span style="color:var(--text-sub);font-style:italic;">[Deleted]</span>
								}
								</td>
								<td><span class="ctag ctag-muted">{ loan.BookCopy.Format.DisplayName() }</span></td>
								<td>{ loan.DateCheckout.Format("Jan 2, 2006") }</td>
								<td>{ due.Format("Jan 2, 2006") }</td>
								<td><span class={ "ctag " + ctagClass }>{ text }</span></td>
							</tr>
						}
					</tbody>
				</table>
			}
		</div>
	</main>
	@common.Footer()
}

func pluralS(n int) string {
	if n == 1 {
		return ""
	}
	return "s"
}
