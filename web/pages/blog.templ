package pages

import (
	"voxelprismatic/library-management-senior-project/router/fail"
	"voxelprismatic/library-management-senior-project/web/common"
)

templ BlogPage(p *fail.RoutingParams) {
	@common.Head("Staff Picks & Blog · Town Library", "Explore staff picks, library news, and blog posts from the Town Library team.")
	@common.NavHead(p.User, p.Req.URL.Path, "")
	<main class="page-main">
		<div class="container">
			<h1>Staff Picks &amp; Library Blog</h1>
			<div class="mt-6">
				<article class="card-flat mb-4">
					<h2><a href="/blog/1">Staff Picks: Summer Reading</a></h2>
					<p class="text-sub text-sm">Posted June 2026 · by Library Staff</p>
					<p>Our librarians share their favorite fiction titles for summer reading.</p>
					<div class="mt-2">
						<span class="ctag ctag-teal">Staff Picks</span>
						<span class="ctag ctag-sky">Fiction</span>
					</div>
					<div class="mt-4"><a href="/blog/1">Read more →</a></div>
				</article>
				<article class="card-flat mb-4">
					<h2><a href="/blog/2">New Arrivals — June 2026</a></h2>
					<p class="text-sub text-sm">Posted June 2026 · by Library Staff</p>
					<p>Discover the latest additions to our non-fiction collection.</p>
					<div class="mt-2">
						<span class="ctag ctag-green">New Arrivals</span>
						<span class="ctag ctag-muted">Non-fiction</span>
					</div>
					<div class="mt-4"><a href="/blog/2">Read more →</a></div>
				</article>
				<article class="card-flat mb-4">
					<h2><a href="/blog/3">A Note from Our Librarians</a></h2>
					<p class="text-sub text-sm">Posted June 2026 · by Library Staff</p>
					<p>A warm welcome from the Town Library team to our community.</p>
					<div class="mt-2">
						<span class="ctag ctag-peach">Community</span>
						<span class="ctag ctag-muted">Announcements</span>
					</div>
					<div class="mt-4"><a href="/blog/3">Read more →</a></div>
				</article>
			</div>
		</div>
	</main>
	@common.Footer()
}
