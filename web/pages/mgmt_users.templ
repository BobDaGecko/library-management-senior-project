package pages

import (
	"fmt"
	"strconv"
	"strings"
	"time"
	"voxelprismatic/library-management-senior-project/db"
	"voxelprismatic/library-management-senior-project/router/fail"
	"voxelprismatic/library-management-senior-project/web/common"
)

const usersPerPage = 50

func userInitials(firstName, lastName string) string {
	result := ""
	if len(firstName) > 0 {
		result += strings.ToUpper(firstName[:1])
	}
	if len(lastName) > 0 {
		result += strings.ToUpper(lastName[:1])
	}
	if result == "" {
		return "?"
	}
	return result
}

func getUsers(page int) []db.User {
	if page < 1 {
		page = 1
	}
	offset := (page - 1) * usersPerPage
	var users []db.User
	db.Db().Model(&db.User{}).Order("last_name asc, first_name asc").Offset(offset).Limit(usersPerPage).Find(&users)
	return users
}

func getUserTotal() int64 {
	var count int64
	db.Db().Model(&db.User{}).Count(&count)
	return count
}

func getUserTotalPages() int {
	total := getUserTotal()
	if total == 0 {
		return 1
	}
	return int((total + int64(usersPerPage) - 1) / int64(usersPerPage))
}

// MgmtUsers full page
templ MgmtUsers(p *fail.RoutingParams, page int) {
	@common.Head("Users — Management", "User Management")
	@common.MgmtNavHead(p.Req.URL.Path)
	<main class="page-main">
		<div class="container">
			<h1 class="mb-2">Users</h1>
			<p class="text-sub mb-6">Manage library users and their roles. Role changes apply immediately.</p>
			<div id="users-container">
				@MgmtUsersTable(page)
			</div>
		</div>
	</main>
	@common.Footer()
}

// MgmtUsersTable for list + pagination (supports HTMX partial)
templ MgmtUsersTable(page int) {
	<div id="users-table">
		<table class="table">
			<thead>
				<tr>
					<th>Name</th>
					<th>Email</th>
					<th>Role</th>
					<th>Status</th>
				</tr>
			</thead>
			<tbody>
				for _, u := range getUsers(page) {
					<tr>
						<td>
							<a href={ templ.SafeURL("/management/users/" + u.ID.String()) }>
								{ u.FirstName } { u.LastName }
							</a>
						</td>
						<td>{ u.Email }</td>
						<td>@UserRoleSelect(u.ID.String(), u.Roles)
</td>
						<td>@userDetailStatusCtag(u.Status)</td>
					</tr>
				}
			</tbody>
		</table>
		@common.Pagination("users-pager", page, getUserTotalPages(), "users-container", "/management/users")
	</div>
}

// UserRoleSelect renders an auto-updating role dropdown. Used in table and re-rendered after HTMX update.
templ UserRoleSelect(userID string, current db.UserRoleFlag) {
	<select
		class="form-select"
		name="role"
		hx-post="/management/users"
		hx-target="this"
		hx-swap="outerHTML"
		hx-trigger="change"
		hx-vals={ fmt.Sprintf(`{"user_id": "%s", "action": "update_role"}`, userID) }
	>
		if current == db.UserRolePublic {
			<option value="1" selected>Public</option>
		} else {
			<option value="1">Public</option>
		}
		if current == db.UserRoleLibrarian {
			<option value="2" selected>Librarian</option>
		} else {
			<option value="2">Librarian</option>
		}
		if current == db.UserRoleAdmin {
			<option value="4" selected>Admin</option>
		} else {
			<option value="4">Admin</option>
		}
	</select>
}

func getUserForDetail(userID string) (db.User, bool) {
	var user db.User
	err := db.Db().Where("id = ?", userID).First(&user).Error
	return user, err == nil
}

func getUserDetailLoans(userID string) []db.Loan {
	var loans []db.Loan
	db.Db().
		Where("user_id = ?", userID).
		Preload("BookCopy.BookWork").
		Order("date_checkout DESC").
		Find(&loans)
	return loans
}

func getUserDetailOpenHolds(userID string) []db.Hold {
	var holds []db.Hold
	db.Db().
		Where("user_id = ? AND fulfilled_date = ? AND cancelled_date = ?", userID, db.NilTime, db.NilTime).
		Preload("BookWork").
		Find(&holds)
	return holds
}

func getUserDetailFines(userID string) []db.Fine {
	var fines []db.Fine
	db.Db().
		Joins("JOIN loans ON loans.id = fines.loan_id AND loans.deleted_at IS NULL").
		Where("loans.user_id = ? AND fines.amount_remaining > 0 AND fines.deleted_at IS NULL", userID).
		Preload("Loan.BookCopy.BookWork").
		Find(&fines)
	return fines
}

// UserDetail replaces the stub with a full summary + tabbed detail view.
templ UserDetail(p *fail.RoutingParams, userID string, tab string) {
	{{ user, ok := getUserForDetail(userID) }}
	if !ok {
		@common.Head("User Not Found — Management", "User not found")
		@common.MgmtNavHead(p.Req.URL.Path)
		<main class="page-main">
			<div class="container">
				<p class="text-sub">User not found.</p>
			</div>
		</main>
		@common.Footer()
	} else {
		{{ loans, _ := user.CheckedOut() }}
		@common.Head("User Detail — Management", "User details")
		@common.MgmtNavHead(p.Req.URL.Path)
		<main class="page-main">
			<div class="container">
				<div class="flex items-center gap-3 mb-6">
					<a href="/management/users" class="btn btn-sm btn-subtle">← Users</a>
					<h1 class="mb-0">{ user.FirstName } { user.LastName }</h1>
				</div>
				<div class="user-profile-card mb-6">
					<div class="user-avatar">{ userInitials(user.FirstName, user.LastName) }</div>
					<div class="user-profile-body">
						<div class="user-profile-name">
							@userRoleCtag(user.Roles)
							@userDetailStatusCtag(user.Status)
						</div>
						<div class="user-profile-meta">
							<span class="user-profile-meta-item">
								<i class="material-icons">email</i>
								{ user.Email }
							</span>
							<span class="user-profile-meta-item">
								<i class="material-icons">bookmark</i>
								{ strconv.Itoa(len(loans)) } book(s) checked out
							</span>
						</div>
						<div class="user-profile-uuid">{ userID }</div>
					</div>
				</div>
				<nav class="tabs mb-6">
					<a
						href={ templ.SafeURL(fmt.Sprintf("/management/users/%s?tab=loans", userID)) }
						class={ "tab", templ.KV("active", tab == "loans") }
					>Loans</a>
					<a
						href={ templ.SafeURL(fmt.Sprintf("/management/users/%s?tab=holds", userID)) }
						class={ "tab", templ.KV("active", tab == "holds") }
					>Holds</a>
					<a
						href={ templ.SafeURL(fmt.Sprintf("/management/users/%s?tab=fines", userID)) }
						class={ "tab", templ.KV("active", tab == "fines") }
					>Fines</a>
				</nav>
				if tab == "holds" {
					@userDetailHoldsTab(userID)
				} else if tab == "fines" {
					@userDetailFinesTab(userID)
				} else {
					@userDetailLoansTab(userID)
				}
			</div>
		</main>
		@common.Footer()
	}
}

templ userDetailLoansTab(userID string) {
	{{ loans := getUserDetailLoans(userID) }}
	if len(loans) == 0 {
		<div class="card-flat">
			<div class="empty-state">
				<i class="material-icons empty-state-icon">bookmark_border</i>
				<p class="empty-state-text">No loan history.</p>
			</div>
		</div>
	} else {
		<table class="table">
			<thead>
				<tr>
					<th>Title</th>
					<th>Checked Out</th>
					<th>Due</th>
					<th>Returned</th>
					<th>Status</th>
				</tr>
			</thead>
			<tbody>
				for _, l := range loans {
					<tr>
						<td>@BookTitle(l.BookCopy.BookWork.Title)</td>
						<td>{ l.DateCheckout.Format("2006-01-02") }</td>
						<td>{ l.DateCheckout.Add(db.LOAN_DURATION).Format("2006-01-02") }</td>
						<td>
							if l.DateReturned.IsZero() {
								<em class="text-sub">Active</em>
							} else {
								{ l.DateReturned.Format("2006-01-02") }
							}
						</td>
						<td>@loanStatusCtag(l.Status())</td>
					</tr>
				}
			</tbody>
		</table>
	}
}

templ userDetailHoldsTab(userID string) {
	{{ holds := getUserDetailOpenHolds(userID) }}
	if len(holds) == 0 {
		<div class="card-flat">
			<div class="empty-state">
				<i class="material-icons empty-state-icon">hourglass_empty</i>
				<p class="empty-state-text">No open holds.</p>
			</div>
		</div>
	} else {
		<table class="table">
			<thead>
				<tr>
					<th>Title</th>
					<th>Format</th>
					<th>Requested</th>
					<th>Status</th>
				</tr>
			</thead>
			<tbody>
				for _, h := range holds {
					{{ status, _ := h.Status() }}
					<tr>
						<td>@BookTitle(h.BookWork.Title)</td>
						<td><span class="ctag ctag-sky">{ h.Format.DisplayName() }</span></td>
						<td>{ h.RequestedDate.Format("2006-01-02") }</td>
						<td>@holdStatusCtag(status)</td>
					</tr>
				}
			</tbody>
		</table>
	}
}

templ userDetailFinesTab(userID string) {
	{{ fines := getUserDetailFines(userID) }}
	if len(fines) == 0 {
		<div class="card-flat">
			<div class="empty-state">
				<i class="material-icons empty-state-icon">payments</i>
				<p class="empty-state-text">No outstanding fines.</p>
			</div>
		</div>
	} else {
		<table class="table">
			<thead>
				<tr>
					<th>Title</th>
					<th>Reason</th>
					<th>Issued</th>
					<th>Remaining</th>
					<th>Date</th>
				</tr>
			</thead>
			<tbody>
				for _, f := range fines {
					<tr>
						<td>@BookTitle(f.Loan.BookCopy.BookWork.Title)</td>
						<td>@fineReasonCtag(f.IssueReason)</td>
						<td>{ fmt.Sprintf("$%.2f", f.AmountIssued) }</td>
						<td>{ fmt.Sprintf("$%.2f", f.AmountRemaining) }</td>
						<td>{ f.IssueDate.Format("2006-01-02") }</td>
					</tr>
				}
			</tbody>
		</table>
	}
}

templ userDetailStatusCtag(status db.UserStatusFlag) {
	switch status {
	case db.UserStatusActive:
		<span class="ctag ctag-green">{ status.DisplayName() }</span>
	case db.UserStatusLimited:
		<span class="ctag ctag-peach">{ status.DisplayName() }</span>
	case db.UserStatusLocked, db.UserStatusDeleted:
		<span class="ctag ctag-red">{ status.DisplayName() }</span>
	default:
		<span class="ctag ctag-muted">{ status.DisplayName() }</span>
	}
}

templ userRoleCtag(role db.UserRoleFlag) {
	switch role {
	case db.UserRoleAdmin:
		<span class="ctag ctag-red">{ role.DisplayName() }</span>
	case db.UserRoleLibrarian:
		<span class="ctag ctag-teal">{ role.DisplayName() }</span>
	case db.UserRolePublic:
		<span class="ctag ctag-sky">{ role.DisplayName() }</span>
	default:
		<span class="ctag ctag-muted">{ role.DisplayName() }</span>
	}
}

templ loanStatusCtag(status db.LoanStatusFlag) {
	switch status {
	case db.LoanStatusReturned:
		<span class="ctag ctag-green">{ status.DisplayName() }</span>
	case db.LoanStatusCheckedOut:
		<span class="ctag ctag-sky">{ status.DisplayName() }</span>
	case db.LoanStatusOverdue:
		<span class="ctag ctag-peach">{ status.DisplayName() }</span>
	default:
		<span class="ctag ctag-muted">{ status.DisplayName() }</span>
	}
}

templ holdStatusCtag(status db.HoldStatusFlag) {
	switch status {
	case db.HoldQueued:
		<span class="ctag ctag-sky">{ status.DisplayName() }</span>
	case db.HoldPostponed:
		<span class="ctag ctag-peach">{ status.DisplayName() }</span>
	case db.HoldCompleted:
		<span class="ctag ctag-green">{ status.DisplayName() }</span>
	default:
		<span class="ctag ctag-muted">{ status.DisplayName() }</span>
	}
}

templ fineReasonCtag(reason db.FineReasonFlag) {
	switch reason {
	case db.FineReasonLate:
		<span class="ctag ctag-peach">{ reason.DisplayName() }</span>
	case db.FineReasonLost:
		<span class="ctag ctag-red">{ reason.DisplayName() }</span>
	case db.FineReasonDamaged:
		<span class="ctag ctag-peach">{ reason.DisplayName() }</span>
	default:
		<span class="ctag ctag-muted">{ reason.DisplayName() }</span>
	}
}

// unused import guard
var _ = time.Now
