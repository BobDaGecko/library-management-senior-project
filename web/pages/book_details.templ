package pages

import "voxelprismatic/library-management-senior-project/web/common"

templ BookDetailsPage() {
	@common.Head("Book Details · Town Library", "View book details, availability by format, and actions like placing holds or bookmarking.")
	<body class="bg-base">
		@common.NavHead("Book Details", "")

		<!-- Sub nav matching user pages pattern -->
		<nav class="mt-2" style="border-bottom: solid var(--tertiary);">
			<div class="navbar-collapse justify-between">
				<ul class="navbar-nav">
					<li><a href="#">Explore <i class="material-icons">arrow_drop_down</i></a></li>
					<li><a href="#">Services <i class="material-icons">arrow_drop_down</i></a></li>
					<li><a href="#">Events <i class="material-icons">arrow_drop_down</i></a></li>
					<li><a href="#">About Us <i class="material-icons">arrow_drop_down</i></a></li>
				</ul>
				<ul class="navbar-nav">
					<li><a href="/account"><i class="material-icons mb-2">account_circle</i> My Account</a></li>
					<li><a href="/help"><i class="material-icons mb-2">help</i> Help</a></li>
				</ul>
			</div>
		</nav>

		<main class="container-lg mt-8">

			<div class="two-col">

				<!-- Left: Cover Image -->
				<section>
					<img
						src="/assets/img/placeholder.jpg"
						alt="Book cover"
						class="rounded shadow"
					/>
				</section>

				<!-- Right: Metadata & Actions -->
				<section class="stack">

					<h1>Modern World History</h1>
					<p class="text-muted">by Jane Smith</p>

					<!-- Genre Tags -->
					<div class="demo-row">
						<span class="badge">History</span>
						<span class="badge">Non‑fiction</span>
						<span class="badge">Academic</span>
					</div>

					<!-- Action Area -->
					<div class="demo-row mt-4">
						<button class="btn btn-primary">
							<i class="material-icons">bookmark</i>
							Place Hold
						</button>
						<button class="btn btn-secondary">
							<i class="material-icons">favorite_border</i>
							Bookmark
						</button>
						<button class="btn btn-ghost">
							<i class="material-icons">star_border</i>
							Rate
						</button>
					</div>

					<!-- Description -->
					<p>
						A concise overview of major global events shaping the modern era,
						designed for both casual readers and academic study.
					</p>

					<!-- Full Metadata -->
					<ul class="list border rounded">
						<li class="list-item"><strong>ISBN:</strong> 978‑ 1‑123456‑789‑0</li>
						<li class="list-item"><strong>Publisher:</strong> Academic Press</li>
						<li class="list-item"><strong>Publication Date:</strong> 2021</li>
						<li class="list-item"><strong>Language:</strong> English</li>
						<li class="list-item"><strong>Pages:</strong> 412</li>
					</ul>

				</section>

			</div>

			<!-- Availability by Format -->
			<section class="mt-8">

				<h2>Availability</h2>

				<table class="table table-striped table-hover mt-4">
					<thead>
						<tr>
							<th>Format</th>
							<th>Copy</th>
							<th>Status</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td>Book</td>
							<td>Copy 1</td>
							<td>
								<i class="material-icons text-green">check_circle</i>
								Available
							</td>
						</tr>
						<tr>
							<td>Book</td>
							<td>Copy 2</td>
							<td>
								<i class="material-icons text-red">cancel</i>
								Checked out
							</td>
						</tr>
						<tr>
							<td>eBook</td>
							<td>Digital</td>
							<td>
								<i class="material-icons text-green">check_circle</i>
								Available
							</td>
						</tr>
						<tr>
							<td>Audiobook</td>
							<td>Digital</td>
							<td>
								<i class="material-icons text-red">cancel</i>
								Checked out
							</td>
						</tr>
					</tbody>
				</table>

			</section>

		</main>

		@common.Footer()
	</body>
}
