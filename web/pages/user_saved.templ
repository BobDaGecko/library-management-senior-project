package pages

import "voxelprismatic/library-management-senior-project/web/common"

templ SavedPage() {
	@common.Head("Saved Items · Town Library", "Review, rate, or remove items you’ve saved.")
	<body class="bg-base">
		@common.NavHead("Account", "")

		<!-- Sub nav matching account/public pattern -->
		<nav class="mt-2" style="border-bottom: solid var(--tertiary);">
			<div class="navbar-collapse justify-between">
				<ul class="navbar-nav">
					<li><a href="#">Explore <i class="material-icons">arrow_drop_down</i></a></li>
					<li><a href="#">Services <i class="material-icons">arrow_drop_down</i></a></li>
					<li><a href="#">Events <i class="material-icons">arrow_drop_down</i></a></li>
					<li><a href="#">About Us <i class="material-icons">arrow_drop_down</i></a></li>
				</ul>
				<ul class="navbar-nav">
					<li><a href="/account"><i class="material-icons mb-2">account_circle</i> My Account</a></li>
					<li><a href="/help"><i class="material-icons mb-2">help</i> Help</a></li>
				</ul>
			</div>
		</nav>

		<main class="container-lg mt-8">
			<header class="between mb-6">
				<div>
					<h1>Saved Items</h1>
					<p class="text-muted">
						Review, rate, or remove items you’ve saved.
					</p>
				</div>

				<a href="/account" class="btn btn-link">
					← Back to Account
				</a>
			</header>

			<!-- Sorting Controls -->
			<div class="between mb-4">
				<span class="text-sm text-muted">
					Showing saved items
				</span>

				<select class="form-input select w-fit">
					<option>Sort by title</option>
					<option>Sort by rating</option>
				</select>
			</div>

			<!-- Saved Items List -->
			<section class="three-col">

				<!-- Saved Item Card -->
				<article class="card">
					<div class="card-body">

						<h3>
							<a href="/">Modern World History</a>
						</h3>

						<p class="text-sm text-muted">
							by Jane Smith · Book
						</p>

						<!-- Rating -->
						<div class="demo-row mb-4">
							<i class="material-icons">star</i>
							<i class="material-icons">star</i>
							<i class="material-icons">star</i>
							<i class="material-icons text-muted">star_border</i>
							<i class="material-icons text-muted">star_border</i>
						</div>

						<button class="btn btn-danger btn-sm">
							Remove
						</button>

					</div>
				</article>

				<!-- Saved Item Card -->
				<article class="card">
					<div class="card-body">

						<h3>
							<a href="/">History Through Stories</a>
						</h3>

						<p class="text-sm text-muted">
							by Alan Cooper · eBook
						</p>

						<!-- Rating -->
						<div class="demo-row mb-4">
							<i class="material-icons">star</i>
							<i class="material-icons">star</i>
							<i class="material-icons text-muted">star_border</i>
							<i class="material-icons text-muted">star_border</i>
						</div>

						<button class="btn btn-danger btn-sm">
							Remove
						</button>

					</div>
				</article>

				<!-- Saved Item Card -->
				<article class="card">
					<div class="card-body">

						<h3>
							<a href="/">The Great Adventure</a>
						</h3>

						<p class="text-sm text-muted">
							by Mark Lewis · Audiobook
						</p>

						<!-- Rating -->
						<div class="demo-row mb-4">
							<i class="material-icons">star</i>
							<i class="material-icons">star</i>
							<i class="material-icons">star</i>
							<i class="material-icons text-muted">star_border</i>
						</div>

						<button class="btn btn-danger btn-sm">
							Remove
						</button>

					</div>
				</article>

			</section>
		</main>

		@common.Footer()
	</body>
}
