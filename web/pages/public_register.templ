package pages

import (
	"voxelprismatic/library-management-senior-project/router/fail"
	"voxelprismatic/library-management-senior-project/web/common"
	"voxelprismatic/library-management-senior-project/web/user"
)

// RegisterPage is the full patron register page.
templ RegisterPage(p *fail.RoutingParams) {
	@common.Head("Register · Town Library", "Create your Town Library account.")
	@common.NavHead(nil, "/user/register", "")
	<main class="page-main">
		<div class="container">
			<div class="auth-page-center">
				<div class="card-flat auth-card">
					<h1 class="auth-heading">Create your library account</h1>
					<p class="text-sub auth-subheading">Join Town Library to place holds, manage loans, and more.</p>
					<form hx-post="/user/register" hx-target="#formEntry" hx-swap="outerHTML">
						@user.FormTable(user.RegisterFormEntries, map[string]string{}, map[string]error{})
						<button type="submit" class="btn btn-primary auth-submit-btn">Create Account</button>
					</form>
					<p class="auth-alt-link">Already have an account? <a href="/user/login">Log in →</a></p>
				</div>
			</div>
		</div>
	</main>
	@common.Footer()
}
