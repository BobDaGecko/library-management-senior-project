package pages

import "voxelprismatic/library-management-senior-project/web/common"

templ RegisterPage() {
	@common.Head("Register · Town Library", "Create a library account to place holds, save items, and manage your loans.")
	<body class="bg-base">
		@common.NavHead("Register", "")

		<!-- Sub nav matching public pattern -->
		<nav class="mt-2" style="border-bottom: solid var(--tertiary);">
			<div class="navbar-collapse justify-between">
				<ul class="navbar-nav">
					<li><a href="#">Explore <i class="material-icons">arrow_drop_down</i></a></li>
					<li><a href="#">Services <i class="material-icons">arrow_drop_down</i></a></li>
					<li><a href="#">Events <i class="material-icons">arrow_drop_down</i></a></li>
					<li><a href="#">About Us <i class="material-icons">arrow_drop_down</i></a></li>
				</ul>
				<ul class="navbar-nav">
					<li><a href="/account"><i class="material-icons mb-2">account_circle</i> My Account</a></li>
					<li><a href="/help"><i class="material-icons mb-2">help</i> Help</a></li>
				</ul>
			</div>
		</nav>

		<main class="container-lg mt-8">
			<section class="card max-w-sm mx-auto">
				<div class="card-body">

					<h1>Create an Account</h1>

					<p class="text-sm text-muted mb-4">
						Register for a library card to place holds, bookmark items,
						and manage your account.
					</p>

					<form action="/register" method="post">

						<div class="form-group">
							<label for="name" class="form-label">Full Name</label>
							<input
								type="text"
								id="name"
								name="name"
								class="form-input"
								placeholder="Jane Doe"
								required
							/>
							<span class="form-error">
								Please enter your full name.
							</span>
						</div>

						<div class="form-group">
							<label for="email" class="form-label">Email Address</label>
							<input
								type="email"
								id="email"
								name="email"
								class="form-input"
								placeholder="you@example.com"
								required
							/>
							<span class="form-error">
								Please enter a valid email address.
							</span>
						</div>

						<div class="form-group">
							<label for="password" class="form-label">Password</label>
							<input
								type="password"
								id="password"
								name="password"
								class="form-input"
								placeholder="••••••••"
								required
							/>
							<span class="form-error">
								Password must meet minimum requirements.
							</span>
							<p class="form-hint">
								Use at least 8 characters.
							</p>
						</div>

						<div class="form-group">
							<label for="confirm_password" class="form-label">
								Confirm Password
							</label>
							<input
								type="password"
								id="confirm_password"
								name="confirm_password"
								class="form-input"
								placeholder="••••••••"
								required
							/>
							<span class="form-error">
								Passwords do not match.
							</span>
						</div>

						<div class="form-group mt-4">
							<button type="submit" class="btn btn-primary w-full">
								Create Account
							</button>
						</div>

					</form>

					<p class="text-sm text-muted mt-4">
						Already have an account?
						<a href="/login">Log in</a>
					</p>

				</div>
			</section>
		</main>

		@common.Footer()
	</body>
}
