package pages

import (
	"strings"

	"voxelprismatic/library-management-senior-project/db"
)

// BookMgmtNotInLibraryWarning is the extracted component for the warning banner
// shown when accessing a Google Books volume under management that isn't
// yet added to the local library. Includes the Add to Library HTMX action.
templ BookMgmtNotInLibraryWarning(book db.BookWork, id string) {
	<div class="container">
		<div class="alert alert-warning mb-4">
			<strong>Warning:</strong> This book is not yet in your library.
		</div>

		<div class="card">
			<div class="card-body">
				<h2>{ book.Title }</h2>
				<p class="text-secondary">by { strings.Join(book.Authors, ", ") }</p>
				{ book.Description }
				<div class="mt-4">
					<button 
						hx-put={ "/management/books/" + id }
						hx-target="closest .card" 
						hx-swap="outerHTML"
						class="btn btn-primary">
						Add to Library
					</button>
				</div>
			</div>
		</div>
	</div>
}
