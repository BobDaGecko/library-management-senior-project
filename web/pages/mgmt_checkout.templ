package pages

import (
	"fmt"
	"time"
	"voxelprismatic/library-management-senior-project/db"
	"voxelprismatic/library-management-senior-project/router/fail"
	"voxelprismatic/library-management-senior-project/web/common"
)

// MgmtCheckout is the full checkout page shell.
templ MgmtCheckout(p *fail.RoutingParams) {
	@common.Head("Checkout — Management", "Check out books to patrons")
	@common.MgmtNavHead(p.Req.URL.Path)
	<main class="page-main">
		<div class="container">
			<h1 class="mb-2">Checkout</h1>
			<p class="text-sub mb-6">Find a patron, then select an available copy to check out.</p>
			<div id="checkout-workflow">
				@CheckoutPatronSearch("")
			</div>
		</div>
	</main>
	@common.Footer()
}

// CheckoutPatronSearch renders the patron search input and empty results container.
templ CheckoutPatronSearch(q string) {
	<div class="card-flat mb-6">
		<h2 class="mb-4">Find Patron</h2>
		<input
			type="text"
			name="q"
			value={ q }
			placeholder="Search by name or email..."
			class="form-input mb-4"
			hx-get="/management/checkout"
			hx-trigger="input delay:300ms"
			hx-vals='{"step":"patron"}'
			hx-target="#patron-results"
			hx-swap="innerHTML"
		/>
		<div id="patron-results"></div>
	</div>
}

// CheckoutPatronResults is returned by HTMX patron search; swaps into #patron-results.
templ CheckoutPatronResults(users []db.User) {
	if len(users) == 0 {
		<p class="text-sub">No patrons found.</p>
	} else {
		<ul style="list-style:none;padding:0;margin:0;">
			for _, u := range users {
				<li style="margin-bottom:var(--space-1);">
					<button
						type="button"
						class="btn btn-subtle w-full"
						style="text-align:left;"
						hx-get="/management/checkout"
						hx-vals={ fmt.Sprintf(`{"step":"patron_selected","user_id":"%s"}`, u.ID.String()) }
						hx-target="#checkout-workflow"
						hx-swap="innerHTML"
					>
						<strong>{ u.FirstName } { u.LastName }</strong> &mdash; { u.Email }
					</button>
				</li>
			}
		</ul>
	}
}

// CheckoutPatronSelected replaces #checkout-workflow after a patron is chosen.
templ CheckoutPatronSelected(user db.User, loanCount int) {
	<div class="card-flat mb-6">
		<div class="flex items-center gap-3 mb-3">
			<h2 class="mb-0">{ user.FirstName } { user.LastName }</h2>
			@checkoutStatusCtag(user.Status)
		</div>
		<p class="text-sub mb-1">{ user.Email }</p>
		<p class="text-sub">{ fmt.Sprintf("%d book(s) currently checked out", loanCount) }</p>
	</div>
	<div class="card-flat">
		<h2 class="mb-4">Find Copy</h2>
		<input
			type="text"
			name="q"
			placeholder="Search by title or author..."
			class="form-input mb-4"
			hx-get="/management/checkout"
			hx-trigger="input delay:300ms"
			hx-vals={ fmt.Sprintf(`{"step":"copy","user_id":"%s"}`, user.ID.String()) }
			hx-target="#copy-results"
			hx-swap="innerHTML"
		/>
		<div id="copy-results"></div>
	</div>
}

// CheckoutCopyResults swaps into #copy-results.
templ CheckoutCopyResults(copies []db.BookCopy, userID string) {
	if len(copies) == 0 {
		<p class="text-sub">No available copies found.</p>
	} else {
		<ul style="list-style:none;padding:0;margin:0;">
			for _, c := range copies {
				<li style="margin-bottom:var(--space-1);">
					<button
						type="button"
						class="btn btn-subtle w-full"
						style="text-align:left;"
						hx-get="/management/checkout"
						hx-vals={ fmt.Sprintf(`{"step":"copy_selected","user_id":"%s","copy_id":"%s"}`, userID, c.ID.String()) }
						hx-target="#checkout-workflow"
						hx-swap="innerHTML"
					>
						<strong>{ c.BookWork.Title }</strong>
						<span class="ctag ctag-sky" style="margin-left:var(--space-2);">{ c.Format.DisplayName() }</span>
						<span class="text-sub" style="margin-left:var(--space-2);">{ c.Condition.DisplayName() }</span>
					</button>
				</li>
			}
		</ul>
	}
}

// CheckoutConfirmCard shows the confirmation before POST. ISS-02 wires the submit.
templ CheckoutConfirmCard(user db.User, copy db.BookCopy, userID string, copyID string) {
	<div class="card-flat mb-6">
		<h2 class="mb-4">Confirm Checkout</h2>
		<table class="table mb-4" style="width:auto;">
			<tbody>
				<tr>
					<td class="label" style="padding-right:var(--space-6);">Patron</td>
					<td>{ user.FirstName } { user.LastName }</td>
				</tr>
				<tr>
					<td class="label">Book</td>
					<td>{ copy.BookWork.Title }</td>
				</tr>
				<tr>
					<td class="label">Format</td>
					<td><span class="ctag ctag-sky">{ copy.Format.DisplayName() }</span></td>
				</tr>
				<tr>
					<td class="label">Due Date</td>
					<td>{ time.Now().Add(db.LOAN_DURATION).Format("2006-01-02") }</td>
				</tr>
			</tbody>
		</table>
		<form hx-post="/management/checkout" hx-target="#checkout-workflow" hx-swap="innerHTML">
			<input type="hidden" name="action" value="checkout"/>
			<input type="hidden" name="user_id" value={ userID }/>
			<input type="hidden" name="copy_id" value={ copyID }/>
			<button type="submit" class="btn btn-primary">Confirm Checkout</button>
			<a href="/management/checkout" class="btn btn-ghost" style="margin-left:var(--space-3);">Cancel</a>
		</form>
	</div>
}

// CheckoutSuccess resets the page to empty state with a green success banner.
templ CheckoutSuccess(userName string, bookTitle string, dueDate time.Time) {
	<div class="card-flat mb-6" style="border-color:var(--green);">
		<p style="color:var(--green);font-weight:600;">Checked out — due { dueDate.Format("2006-01-02") }</p>
		<p class="text-sub">{ bookTitle } → { userName }</p>
	</div>
	@CheckoutPatronSearch("")
}

// CheckoutErrorState shows inline error without clearing the patron selection.
templ CheckoutErrorState(user db.User, loanCount int, errMsg string) {
	<div class="card-flat mb-6">
		<div class="flex items-center gap-3 mb-3">
			<h2 class="mb-0">{ user.FirstName } { user.LastName }</h2>
			@checkoutStatusCtag(user.Status)
		</div>
		<p class="text-sub mb-1">{ user.Email }</p>
		<p class="text-sub">{ fmt.Sprintf("%d book(s) currently checked out", loanCount) }</p>
	</div>
	<div class="card-flat mb-4" style="border-color:var(--red);">
		<p style="color:var(--red);">{ errMsg }</p>
	</div>
	<div class="card-flat">
		<h2 class="mb-4">Find Copy</h2>
		<input
			type="text"
			name="q"
			placeholder="Search by title or author..."
			class="form-input mb-4"
			hx-get="/management/checkout"
			hx-trigger="input delay:300ms"
			hx-vals={ fmt.Sprintf(`{"step":"copy","user_id":"%s"}`, user.ID.String()) }
			hx-target="#copy-results"
			hx-swap="innerHTML"
		/>
		<div id="copy-results"></div>
	</div>
}

templ checkoutStatusCtag(status db.UserStatusFlag) {
	switch status {
	case db.UserStatusActive:
		<span class="ctag ctag-green">{ status.DisplayName() }</span>
	case db.UserStatusLimited:
		<span class="ctag ctag-peach">{ status.DisplayName() }</span>
	case db.UserStatusLocked, db.UserStatusDeleted:
		<span class="ctag ctag-red">{ status.DisplayName() }</span>
	default:
		<span class="ctag ctag-muted">{ status.DisplayName() }</span>
	}
}
