package pages

import "github.com/VoxelPrismatic/library-management-senior-project/web/common"

templ LoansPage() {
	@common.Head("My Loans · Town Library", "View your currently checked-out items and due dates.")
	<body class="bg-base">
		@common.NavHead("Account", "")

		<!-- Sub nav matching account/public pattern -->
		<nav class="mt-2" style="border-bottom: solid var(--tertiary);">
			<div class="navbar-collapse justify-between">
				<ul class="navbar-nav">
					<li><a href="#">Explore <i class="material-icons">arrow_drop_down</i></a></li>
					<li><a href="#">Services <i class="material-icons">arrow_drop_down</i></a></li>
					<li><a href="#">Events <i class="material-icons">arrow_drop_down</i></a></li>
					<li><a href="#">About Us <i class="material-icons">arrow_drop_down</i></a></li>
				</ul>
				<ul class="navbar-nav">
					<li><a href="/account"><i class="material-icons mb-2">account_circle</i> My Account</a></li>
					<li><a href="/help"><i class="material-icons mb-2">help</i> Help</a></li>
				</ul>
			</div>
		</nav>

		<main class="container-lg mt-8">
			<header class="between mb-6">
				<div>
					<h1>My Loans</h1>
					<p class="text-muted">
						View your currently checked‑out items and due dates.
					</p>
				</div>

				<a href="/account" class="btn btn-link">
					← Back to Account
				</a>
			</header>

			<div class="table-wrapper">
				<table class="table table-striped table-hover">

					<thead>
						<tr>
							<th>
								<button class="btn-ghost">
									Title
									<i class="material-icons" style="font-size: 16px;">unfold_more</i>
								</button>
							</th>
							<th>Format</th>
							<th>
								<button class="btn-ghost">
									Due Date
									<i class="material-icons" style="font-size: 16px;">unfold_more</i>
								</button>
							</th>
							<th>Status</th>
						</tr>
					</thead>

					<tbody>
						<tr>
							<td>
								<a href="/book/1">Modern World History</a>
							</td>
							<td>Book</td>
							<td>June 10, 2026</td>
							<td class="text-green">On time</td>
						</tr>

						<tr>
							<td>
								<a href="/book/2">History Through Stories</a>
							</td>
							<td>eBook</td>
							<td>June 3, 2026</td>
							<td class="text-warning">Due soon</td>
						</tr>

						<tr>
							<td>
								<a href="/book/3">The Great Adventure</a>
							</td>
							<td>Audiobook</td>
							<td>May 29, 2026</td>
							<td class="text-red">Overdue</td>
						</tr>
					</tbody>

				</table>
			</div>
		</main>

		@common.Footer()
	</body>
}
