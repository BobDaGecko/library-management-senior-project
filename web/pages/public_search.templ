package pages

import (
	"strings"

	"voxelprismatic/library-management-senior-project/db"
	"voxelprismatic/library-management-senior-project/router/fail"
	"voxelprismatic/library-management-senior-project/web/book"
	"voxelprismatic/library-management-senior-project/web/common"
)

// SearchFilter holds all filter/sort parameters for catalog search.
type SearchFilter struct {
	Q         string
	Format    db.BookFmtFlag // 0 = all formats
	Available bool
	Genre     string
	Sort      string // "", "title", "author", "newest"
}

// SearchBooks queries the catalog with the given filter and returns up to 50 results.
// Exported so router and tests can call it directly.
func SearchBooks(f SearchFilter) []db.BookWork {
	q := db.Db().Model(&db.BookWork{})

	if f.Format != 0 {
		q = q.Joins("JOIN book_copies ON book_copies.book_work_id = book_works.id AND book_copies.status = ?", db.CopyStatusPublic).
			Where("book_copies.format = ?", int(f.Format)).
			Distinct("book_works.*")
	}

	if f.Available {
		q = q.Where(`EXISTS (
			SELECT 1 FROM book_copies bc2
			WHERE bc2.book_work_id = book_works.id
			AND bc2.status = 0
			AND NOT EXISTS (
				SELECT 1 FROM loans l
				WHERE l.book_copy_id = bc2.id
				AND l.date_returned = ?
			)
		)`, db.NilTime)
	}

	if f.Genre != "" {
		q = q.Where("lower(book_works.categories) LIKE ?", "%"+strings.ToLower(f.Genre)+"%")
	}

	if f.Q != "" {
		like := "%" + strings.ToLower(f.Q) + "%"
		q = q.Where(
			db.Db().Where("lower(book_works.title) LIKE ?", like).
				Or("lower(book_works.subtitle) LIKE ?", like).
				Or("lower(book_works.description) LIKE ?", like).
				Or("lower(book_works.authors) LIKE ?", like).
				Or("lower(book_works.publisher) LIKE ?", like),
		)
	}

	switch f.Sort {
	case "title":
		q = q.Order("book_works.title ASC")
	case "author":
		q = q.Order("book_works.authors ASC")
	case "newest":
		q = q.Order("book_works.created_at DESC")
	}

	var results []db.BookWork
	q.Limit(50).Find(&results)
	return results
}

// SearchPage is the full page (initial load).
templ SearchPage(p *fail.RoutingParams, f SearchFilter) {
	@common.Head("Search · Town Library", "Search books, ebooks, and audiobooks in the Town Library catalog.")
	@common.NavHead(p.User, p.Req.URL.Path, f.Q)
	<main class="page-main">
		<div class="container">
			<!-- ── Search bar ────────────────────────────────────── -->
			<div class="mb-4">
				<form action="/search" method="get" role="search">
					<div class="input-search">
						<input
							type="search"
							name="q"
							class="form-input"
							placeholder="Title, author, keyword…"
							value={ f.Q }
							aria-label="Search the library catalog"
						/>
						<button class="btn btn-primary input-icon" type="submit">
							<i class="material-icons">search</i>
						</button>
					</div>
				</form>
			</div>
			<form id="search-filters" hx-get="/search" hx-target="#search-results" hx-include="this">
				<input type="hidden" name="q" value={ f.Q }/>
				<div class="search-filter-panel card-flat">
					<div class="search-filter-group">
						<label for="filter-sort">Sort</label>
						<select
							id="filter-sort"
							name="sort"
							hx-trigger="change"
							hx-get="/search"
							hx-target="#search-results"
							hx-include="closest form"
						>
							<option value="" selected?={ f.Sort == "" }>Relevance</option>
							<option value="title" selected?={ f.Sort == "title" }>Title A–Z</option>
							<option value="author" selected?={ f.Sort == "author" }>Author A–Z</option>
							<option value="newest" selected?={ f.Sort == "newest" }>Newest first</option>
						</select>
					</div>
					<div class="search-filter-group">
						<label for="filter-format">Format</label>
						<select
							id="filter-format"
							name="format"
							hx-trigger="change"
							hx-get="/search"
							hx-target="#search-results"
							hx-include="closest form"
						>
							<option value="0" selected?={ f.Format == 0 }>All formats</option>
							<option value="1" selected?={ f.Format == db.BookFmtPaperback }>Paperback</option>
							<option value="2" selected?={ f.Format == db.BookFmtHardCover }>Hardcover</option>
							<option value="4" selected?={ f.Format == db.BookFmtPhysicalAudio }>Physical Audio</option>
							<option value="8" selected?={ f.Format == db.BookFmtDigitalBook }>Digital Book</option>
							<option value="16" selected?={ f.Format == db.BookFmtDigitalAudio }>Digital Audio</option>
						</select>
					</div>
					<div class="search-filter-group">
						<label for="filter-available">Availability</label>
						<select
							id="filter-available"
							name="available"
							hx-trigger="change"
							hx-get="/search"
							hx-target="#search-results"
							hx-include="closest form"
						>
							<option value="" selected?={ !f.Available }>Any</option>
							<option value="1" selected?={ f.Available }>Available now</option>
						</select>
					</div>
					<div class="search-filter-group">
						<label for="filter-genre">Genre</label>
						<input
							id="filter-genre"
							type="text"
							name="genre"
							placeholder="Filter by genre"
							value={ f.Genre }
							hx-trigger="input delay:400ms"
							hx-get="/search"
							hx-target="#search-results"
							hx-include="closest form"
						/>
					</div>
				</div>
			</form>
			<div id="search-results" class="mt-6">
				@SearchResults(f)
			</div>
		</div>
	</main>
	@common.Footer()
}

// SearchResults is the HTMX fragment (partial reload).
templ SearchResults(f SearchFilter) {
	{{ results := SearchBooks(f) }}
	if len(results) == 0 {
		<div class="empty-state">
			<div class="empty-state-icon"><i class="material-icons">search_off</i></div>
			if f.Q == "" && f.Genre == "" && f.Format == 0 && !f.Available {
				<div class="empty-state-text">The catalog is empty. Check back soon.</div>
			} else {
				<div class="empty-state-text">No results found. Try adjusting your search or filters.</div>
			}
		</div>
	} else {
		for _, b := range results {
			@book.BookTrunk(b)
		}
	}
}
