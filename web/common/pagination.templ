package common

import "fmt"

// Pagination renders a reusable prev/next pagination bar with HTMX support.
// current: current page number (1-based)
// total: total number of pages
// basePath: e.g. "/management/transactions" (will append ?page=N)
// targetSelector: CSS selector for HTMX target, e.g. "#transactions-container"
templ Pagination(current, total int, basePath, targetSelector string) {
	<div class="demo-row justify center mt-4">
		if current > 1 {
			@pageButton(current-1, "Previous", basePath, targetSelector)
		}
		<span class="px-4">Page {current} / {total}</span>
		if current < total {
			@pageButton(current+1, "Next", basePath, targetSelector)
		}
	</div>
}

templ pageButton(targetPage int, label, basePath, targetSelector string) {
	<a
		href={ fmt.Sprintf("%s?page=%d", basePath, targetPage) }
		hx-get={ fmt.Sprintf("%s?page=%d", basePath, targetPage) }
		hx-target={ targetSelector }
		hx-swap="innerHTML"
		hx-push-url="true"
	>{ label }</a>
}