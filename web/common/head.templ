package common

import "strings"

templ Head(title string, desc string) {
	<!DOCTYPE html>
	<head>
		<meta charset="utf-8"/>
		<link rel="icon" href="/assets/favicon.ico"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<meta name="description" content={ desc }/>
		<title>{ title }</title>
		<script type="text/javascript" src="/assets/js/htmx-2.0.8.js"></script>
		<script src="https://cdn.jsdelivr.net/npm/hyperscript.org@0.9.91/dist/_hyperscript.min.js" integrity="sha384-kNli9q2SAIKZyCaj/HsxM+q3rmzWVyOTVcwQ/X1tVf7h38a1wkbfBYpckMRA0eSr" crossorigin="anonymous"></script>
		<link rel="stylesheet" type="text/css" href="/assets/css/semtx.css"/>
		<link rel="stylesheet" type="text/css" href="/assets/css/custom.css"/>
		<link rel="stylesheet" type="text/css" href="https://fonts.googleapis.com/icon?family=Material+Icons"/>
	</head>
}

templ NavHead(subpage string, searchPrefill string) {
	<nav class="navbar">
		<a href="/" class="navbar-brand">
			<img src="/assets/img/placeholder.jpg" alt="Town Library" class="navbar-logo"/>
			<span>Town Library</span>
			if subpage != "" {
				<span class="navbar-sub">{ subpage }</span>
			}
		</a>
		<div class="input-search">
			<input
				class="form-input-lg"
				type="search"
				name="q"
				id="q"
				placeholder="Search..."
				value={ searchPrefill }
			/>
			<button class="btn-small btn-primary input-icon">
				<i class="material-icons">search</i>
			</button>
		</div>
	</nav>
}

// MgmtNavHead is the sticky top navigation bar for all management pages.
// Pass p.Req.URL.Path as active for correct link highlighting.
templ MgmtNavHead(active string) {
	{{ dashActive := active == "/management" }}
	{{ booksActive := strings.HasPrefix(active, "/management/books") || active == "/management/checkout" || active == "/management/return" || active == "/management/repair" }}
	{{ usersActive := strings.HasPrefix(active, "/management/users") || active == "/management/overdue" || active == "/management/holds" || active == "/management/fines" || active == "/management/transactions" }}
	<nav class="navbar mgmt-navbar">
		<div class="mgmt-navbar-inner">
			<a href="/management" class="navbar-brand">
				<img src="/assets/img/placeholder.jpg" alt="Town Library" class="navbar-logo"/>
				<span class="mgmt-brand-name">Town Library</span>
				<span class="mgmt-brand-label">Management</span>
			</a>
			<ul class="navbar-nav">
				<!-- Dashboard -->
				<li>
					<a href="/management" class={ templ.KV("active", dashActive) }>
						<i class="material-icons mgmt-nav-icon">grid_view</i>
						Dashboard
					</a>
				</li>
				<!-- Books dropdown -->
				<li class="nav-dropdown">
					<a href="/management" class={ templ.KV("active", booksActive) }>
						<i class="material-icons mgmt-nav-icon">menu_book</i>
						Books
						<i class="material-icons mgmt-nav-caret">arrow_drop_down</i>
					</a>
					<div class="nav-dropdown-menu">
						<a href="/management/books">Catalog</a>
						<a href="/management/books/add">Add Books</a>
						<div class="nav-dropdown-divider"></div>
						<a href="/management/checkout">Checkout</a>
						<a href="/management/return">Returns</a>
						<a href="/management/repair">Repair Log</a>
					</div>
				</li>
				<!-- Users dropdown -->
				<li class="nav-dropdown">
					<a href="/management/users" class={ templ.KV("active", usersActive) }>
						<i class="material-icons mgmt-nav-icon">people</i>
						Users
						<i class="material-icons mgmt-nav-caret">arrow_drop_down</i>
					</a>
					<div class="nav-dropdown-menu">
						<a href="/management/users">Directory</a>
						<div class="nav-dropdown-divider"></div>
						<a href="/management/overdue">Overdue</a>
						<a href="/management/holds">Holds</a>
						<a href="/management/fines">Fines</a>
						<a href="/management/transactions">Transactions</a>
					</div>
				</li>
			</ul>
		</div>
	</nav>
}

templ NavAside(entries NavAsideEntryList, active string) {
	<aside class="sidebar mt-8 one-col" style="position: fixed;">
		<ul class="sidebar-nav">
			for i, e := range entries {
				if e.Name != "" {
					<li class={ templ.KV("mt-6", entries.HasPrevBlank(i)), templ.KV("mb-6", entries.HasNextBlank(i)) }>
						<a class={ templ.KV("active", e.Link == active) } href={ e.Link }>{ e.Name }</a>
					</li>
				}
			}
		</ul>
	</aside>
}

templ Footer() {
	<footer class="page-footer">
		<div class="container">
			<p class="text-xs" style="color: var(--text-sub);">&#169; 2026 Town Library</p>
		</div>
	</footer>
}
