package book

import (
	"voxelprismatic/library-management-senior-project/db"
	"voxelprismatic/library-management-senior-project/web/common"
)

templ formatShield(flag db.BookFmtFlag) {
	switch flag {
		case db.BookFmtPaperback:
			@common.Shield("import_contacts", "Paperback", "var(--peach)", "var(--text)")
		case db.BookFmtHardCover:
			@common.Shield("book_4", "Hard Cover", "var(--peach)", "var(--text)")
		case db.BookFmtPhysicalAudio:
			@common.Shield("mobile_speaker", "Audio Player", "var(--teal)", "var(--text)")
		case db.BookFmtDigitalBook:
			@common.Shield("text_snippet", "Kindle", "var(--green)", "var(--text)")
		case db.BookFmtDigitalAudio:
			@common.Shield("audio_file", "Audible", "var(--sky)", "var(--text)")
	}
}
