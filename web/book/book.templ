package book

import (
	"regexp"
	"strings"

	"voxelprismatic/library-management-senior-project/db"
	"voxelprismatic/library-management-senior-project/web/common"
)

var htmlTagRe = regexp.MustCompile(`<[^>]+>`)

func stripHTML(s string) string {
	return htmlTagRe.ReplaceAllString(s, "")
}

func bookYear(b db.BookWork) string {
	if b.PublishedDate.IsZero() {
		return ""
	}
	return b.PublishedDate.Format("2006")
}

// BookTrunkAdmin renders a compact search result card for /management/books/add.
templ BookTrunkAdmin(b db.BookWork) {
	<div class="search-result-card" id={ "book-" + b.ID }>
		if b.CoverThumb != "" {
			<img src={ b.CoverThumb } alt={ b.Title + " cover" } class="search-result-cover"/>
		} else {
			<div class="search-result-cover search-result-cover-placeholder">
				<i class="material-icons">menu_book</i>
			</div>
		}
		<div class="search-result-body">
			<div class="search-result-header">
				<div class="search-result-titles">
					<div class="search-result-title">{ b.Title }</div>
					<div class="search-result-meta">
						if len(b.Authors) > 0 {
							<span>by { strings.Join([]string(b.Authors), ", ") }</span>
						}
						if bookYear(b) != "" {
							<span class="search-result-dot">·</span>
							<span>{ bookYear(b) }</span>
						}
						if b.Publisher != "" {
							<span class="search-result-dot">·</span>
							<span>{ b.Publisher }</span>
						}
					</div>
				</div>
				<div class="search-result-action">
					if b.Exists() {
						<a href={ templ.SafeURL("/management/books/" + b.ID) } class="btn btn-sm btn-subtle">
							In Library →
						</a>
					} else {
						<a href={ templ.SafeURL("/management/books/add/" + b.ID + "/preview") } class="btn btn-sm btn-primary">
							<i class="material-icons" style="font-size:14px;vertical-align:-2px;">add</i>
							Add
						</a>
					}
				</div>
			</div>
			if counts, err := b.AvailableCopies(false); err == nil && len(counts) > 0 {
				<div class="search-result-shields">
					for f, count := range counts {
						@common.ShieldFormat(f, count)
					}
				</div>
			}
			if desc := stripHTML(b.Description); desc != "" {
				<p class="search-result-description">{ desc }</p>
			}
		</div>
	</div>
}

// BookTrunk renders a full-width book card for patron-facing search results.
templ BookTrunk(b db.BookWork) {
	<div class="card my-4">
		<div class="book-container">
			@bookTrunkContainer(b, false)
		</div>
	</div>
}

templ bookTrunkContainer(b db.BookWork, admin bool) {
	if b.CoverThumb != "" {
		<img src={ b.CoverThumb } alt={ b.Title + " cover" } class="book-cover"/>
	} else {
		<div class="book-cover" style="background:var(--bg-mantle);display:flex;align-items:center;justify-content:center;color:var(--text-sub);opacity:0.4;">
			<i class="material-icons" style="font-size:2rem;">menu_book</i>
		</div>
	}
	<div class="book-info flex flex-col gap-1">
		if admin {
			<h3 class="book-title mb-0">
				<a href={ templ.SafeURL("/management/books/" + b.ID) }>{ b.Title }</a>
			</h3>
		} else {
			<h3 class="book-title mb-0">
				<a href={ templ.SafeURL("/book/" + b.ID) }>{ b.Title }</a>
			</h3>
		}
		if len(b.Authors) > 0 {
			<span class="text-sub text-sm">
				by { strings.Join([]string(b.Authors), ", ") }
				if bookYear(b) != "" {
					<span style="opacity:0.5"> · </span>{ bookYear(b) }
				}
			</span>
		}
		if len(b.Categories) > 0 {
			{{ cats := []string(b.Categories) }}
			if len(cats) > 2 {
				{{ cats = cats[:2] }}
			}
			<div>
				for _, cat := range cats {
					<span class="ctag ctag-muted">{ cat }</span>
				}
			</div>
		}
		<div class="mt-1">
			if counts, err := b.AvailableCopies(false); err == nil {
				for f, count := range counts {
					@common.ShieldFormat(f, count)
				}
			}
		</div>
		if desc := stripHTML(b.Description); desc != "" {
			<div class="book-description-clamp mt-2">{ desc }</div>
		}
	</div>
}

// BookCover renders a compact cover card for the dashboard "Recently Added" grid.
templ BookCover(b db.BookWork) {
	<a href={ templ.SafeURL("/management/books/" + b.ID) } class="book-cover-card">
		if b.CoverThumb != "" {
			<img src={ b.CoverThumb } alt={ b.Title } class="book-cover-card-img"/>
		} else {
			<div class="book-cover-card-img book-cover-card-placeholder">
				<i class="material-icons">menu_book</i>
			</div>
		}
		<div class="book-cover-card-info">
			<div class="book-cover-card-title">{ b.Title }</div>
			if len(b.Authors) > 0 {
				<div class="book-cover-card-author">{ strings.Join([]string(b.Authors), ", ") }</div>
			}
		</div>
	</a>
}
